{% extends 'base.html.twig' %}

{# Titre dynamique de l'onglet avec le nom du menu consulte. #}
{% block title %}{{ menu.nom_menu }} - Vite & Gourmand{% endblock %}

{% block body %}
{# Grand bandeau avec le nom du menu et son image si elle existe. #}
{% include 'components/_big_title.html.twig' with {
    title: menu.nom_menu,
    image: menu.image_url ? asset(menu.image_url) : asset('assets/bigtittle.png'),
    image_alt: menu.image_alt ?: menu.nom_menu
} %}

{# Contenu principal de la page detail d'un menu. #}
<main class="menu-detail-page">
    {# Description generale du menu. #}
    <section class="menu-detail-intro">
        <p>{{ menu.description }}</p>
    </section>

    {# Mise en page en deux colonnes : composition du menu et informations de commande. #}
    <section class="menu-detail-layout">
        {# Liste des elements du menu : entree, plat et dessert. #}
        <div class="menu-detail-meal-list">
            {% for category, item in mealItems %}
                {% if item %}
                    {# Ligne de presentation d'un element du menu. #}
                    <article class="menu-detail-row">
                        {# Texte de l'element : categorie, nom, description et allergenes. #}
                        <div class="menu-detail-row__content">
                            <h2>{{ category }}</h2>
                            <h3>{{ item.nom }}</h3>
                            <p>{{ item.description }}</p>

                            {# Bloc allergenes affiche uniquement si l'information existe. #}
                            {% if item.allergenes %}
                                <div class="menu-detail-allergens">
                                    <span>Allergènes</span>
                                    <p>{{ item.allergenes }}</p>
                                </div>
                            {% endif %}
                        </div>

                        {# Image de l'element affichee uniquement si un chemin est renseigne. #}
                        {% if item.image_url %}
                            <img
                                src="{{ asset(item.image_url) }}"
                                alt="{{ item.image_alt ?: item.nom }}"
                                class="menu-detail-row__image"
                            >
                        {% endif %}
                    </article>
                {% endif %}
            {% endfor %}
        </div>

        {# Colonne laterale avec le recapitulatif et le bouton commander. #}
        <aside class="menu-detail-sidebar">
            {# Informations rapides : minimum, prix et disponibilite. #}
            <section class="menu-detail-summary" aria-label="Informations du menu">
                <div>
                    <strong>{{ menu.personnes_minimum }} pers. min.</strong>
                    <span>Minimum {{ menu.personnes_minimum }} personnes</span>
                </div>

                <div>
                    <strong>{{ menu.prix_par_personne|number_format(2, ',', ' ') }} € / pers.</strong>
                    <span>Prix par personne</span>
                </div>

                <div>
                    <strong>{{ menu.stock_disponible > 0 ? 'Disponible' : 'Indisponible' }}</strong>
                    <span>Stock disponible</span>
                </div>
            </section>

            {# Conditions propres au menu ou conditions par defaut si rien n'est renseigne en base. #}
            <section class="menu-detail-conditions">
                <h2>Conditions de ce menu</h2>

                {% if menu.conditions %}
                    <p>{{ menu.conditions|nl2br }}</p>
                {% else %}
                    <ul>
                        <li>Commande minimum pour {{ menu.personnes_minimum }} personnes</li>
                        <li>Réservation recommandée 48h à l'avance</li>
                        <li>Menu disponible le midi et le soir</li>
                        <li>Non cumulable avec d'autres promotions</li>
                        <li>Boissons non incluses</li>
                    </ul>
                {% endif %}
            </section>

            {# Formulaire POST protege par CSRF : le bouton Commander ajoute le menu au panier sans passer par une action sensible en simple lien GET. #}
            <section class="menu-detail-order">
                <form action="{{ path('cart_add', { id: menu.menu_id }) }}" method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('cart_action') }}">
                    <button type="submit" class="buttonprimary menu-detail-order__button">Commander</button>
                </form>
                <p>Connectez-vous pour pouvoir commander ce menu</p>
            </section>
        </aside>
    </section>
</main>
{% endblock %}

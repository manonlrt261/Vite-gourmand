{% extends 'base.html.twig' %}

{# Page d’accueil publique : présente l’offre, les engagements et les avis clients. #}
{% block title %}Accueil - Vite & Gourmand{% endblock %}

{% block body %}
<main class="home-page">
    {# Bandeau d’introduction : l’image et son calque garantissent la lisibilité de l’accroche. #}
    <section class="home-festive-hero">
        <img
            src="{{ asset('assets/bigtittle.png') }}"
            alt="Plat raffin&eacute; pr&eacute;par&eacute; par Vite et Gourmand"
            class="home-festive-hero__image"
        >
        <div class="home-festive-hero__overlay" aria-hidden="true"></div>

        <div class="home-festive-hero__content">
            <p>Chaque occasion m&eacute;rite son</p>
            <h1>festin</h1>
            <a href="{{ path('menu_index') }}" class="buttonprimary">D&eacute;couvrez nos menus</a>
        </div>
    </section>

    {# Présentation des engagements qui structurent la prestation de l’entreprise. #}
    <section class="home-section home-professionalism">
        {# Les éléments vides de part et d’autre du libellé servent de traits décoratifs. #}
        <div class="home-kicker">
            <span></span>
            <p>Notre professionnalisme</p>
            <span></span>
        </div>

        <header class="home-section-heading">
            <h2>L'exigence au service de vos plus beaux moments</h2>
            <p>
                Derri&egrave;re chaque menu, il y a un savoir-faire, une organisation rigoureuse
                et surtout, des femmes et des hommes passionn&eacute;s.
            </p>
        </header>

        {# La grille associe le portrait de l’équipe aux cinq arguments de confiance. #}
        <div class="home-values-grid">
            <div class="home-values-grid__image">
                <img
                    src="{{ asset('assets/julieetjose.png') }}"
                    alt="Julie et Jos&eacute; en cuisine"
                >
            </div>

            {# Carte principale mise en avant par une variante visuelle dédiée. #}
            <article class="home-value-card home-value-card--featured">
                <h3>Une cuisine authentique</h3>
                <p>
                    Toutes nos recettes sont &eacute;labor&eacute;es avec passion dans notre laboratoire.
                    Chaque menu est pr&eacute;par&eacute; avec le m&ecirc;me soin.
                </p>
            </article>

            <article class="home-value-card home-value-card--selection">
                <h3>Une s&eacute;lection d'ingr&eacute;dients de qualit&eacute;</h3>
                <p>
                    Nous privil&eacute;gions des produits soigneusement s&eacute;lectionn&eacute;s afin de proposer
                    des recettes savoureuses, pr&eacute;par&eacute;es avec exigence.
                </p>
            </article>

            <article class="home-value-card home-value-card--team">
                <h3>Notre &eacute;quipe, notre force</h3>
                <p>
                    Notre compl&eacute;mentarit&eacute; est au coeur de chaque prestation. Ensemble,
                    nous imaginons des menus pens&eacute;s pour chaque &eacute;v&eacute;nement.
                </p>
            </article>

            <article class="home-value-card home-value-card--organization">
                <h3>Organisation et ponctualit&eacute;</h3>
                <p>
                    Du premier &eacute;change jusqu'&agrave; la livraison, nous veillons au respect
                    des d&eacute;lais afin que vous puissiez profiter sereinement.
                </p>
            </article>

            <article class="home-value-card home-value-card--quality">
                <h3>Qualit&eacute; et confiance</h3>
                <p>
                    Depuis plus de deux d&eacute;cennies, nous avons b&acirc;ti une relation de confiance
                    avec nos clients gr&acirc;ce &agrave; notre exigence.
                </p>
            </article>
        </div>

        <div class="home-centered-button">
            <a href="{{ path('menu_index') }}" class="buttonprimary">Nos menus</a>
        </div>
    </section>

    {# Bloc éditorial consacré à la satisfaction client et incarné par les fondateurs. #}
    <section class="home-success-card">
        <div class="home-success-card__content">
            <h2>Notre plus belle r&eacute;ussite ?</h2>
            <p>Voir nos clients repartir avec le sourire.</p>
            <span>Julie & Jos&eacute;</span>
        </div>

        <img
            src="{{ asset('assets/imageaccueil.png') }}"
            alt="Table &eacute;l&eacute;gante pr&eacute;par&eacute;e pour un &eacute;v&eacute;nement"
            class="home-success-card__image"
        >
    </section>

    {# Appel à l’action intermédiaire vers le formulaire de contact. #}
    <div class="home-contact-cta">
        <a href="{{ path('contact_index') }}" class="buttonwhite">Contactez-nous !</a>
    </div>

    {# Témoignages statiques et synthèse de la note Google. #}
    <section class="home-section home-reviews">
        {# Les éléments vides de part et d’autre du libellé servent de traits décoratifs. #}
        <div class="home-kicker">
            <span></span>
            <p>Avis clients v&eacute;rifi&eacute;s</p>
            <span></span>
        </div>

        <header class="home-section-heading">
            <h2>Ils nous ont fait confiance</h2>
            <p>D&eacute;couvrez les avis de nos clients apr&egrave;s leur &eacute;v&eacute;nement.</p>
        </header>

        {# Avis éditoriaux codés en dur : aucune donnée n’est chargée depuis un service externe. #}
        <div class="home-review-grid">
            <article class="home-review-card">
                <div class="home-review-card__top">
                    <span class="home-quote">&ldquo;</span>
                    <span class="home-stars">★★★★★</span>
                </div>
                <h3>Un repas exceptionnel pour notre mariage !</h3>
                <p>
                    Julie et Jos&eacute; ont su comprendre nos envies et r&eacute;galer tous nos invit&eacute;s.
                    Produits frais, service impeccable et &eacute;quipe aux petits soins.
                </p>
                <footer>
                    <strong>Claire & Thomas</strong>
                    <span>Mariage - Mai 2026</span>
                </footer>
            </article>

            <article class="home-review-card">
                <div class="home-review-card__top">
                    <span class="home-quote">&ldquo;</span>
                    <span class="home-stars">★★★★★</span>
                </div>
                <h3>Nous avons fait appel &agrave; V&G pour notre s&eacute;minaire</h3>
                <p>
                    Tout &eacute;tait parfait, de l'organisation &agrave; la d&eacute;gustation. Des mets
                    d&eacute;licieux et un service tr&egrave;s professionnel.
                </p>
                <footer>
                    <strong>Sophie L.</strong>
                    <span>Ev&eacute;nement professionnel - Mars 2026</span>
                </footer>
            </article>
        </div>

        {# Synthèse statique de la réputation Google, séparée visuellement par deux traits. #}
        <div class="home-google-rating">
            <span></span>
            <p>★★★★★ 4,9 Avis Google</p>
            <span></span>
            <small>Bas&eacute; sur plus de 120 avis clients</small>
        </div>
    </section>
</main>
{% endblock %}

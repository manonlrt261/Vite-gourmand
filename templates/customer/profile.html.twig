{% extends 'base.html.twig' %}

{# Page de gestion des coordonnées, de l’adresse de livraison et du mot de passe du client connecté. #}
{% block title %}Mes informations - Vite & Gourmand{% endblock %}

{% block body %}
{# Bandeau commun aux pages publiques et à l’espace client. #}
{% include 'components/_big_title.html.twig' with {
    title: 'Mes informations',
    image_alt: 'Informations personnelles Vite et Gourmand'
} %}

<main class="customer-page customer-profile-page">
    <a href="{{ path('customer_account') }}" class="cart-back-link">← Retour à mon espace client</a>

    <section class="customer-profile-intro">
        <h1>Mes informations personnelles</h1>
        <p>Modifiez vos informations personnelles ci-dessous.<br>Ces informations seront utilisées pour vos commandes.</p>
    </section>

    {# Retours du contrôleur après la mise à jour du profil ou du mot de passe. #}
    {% for message in app.flashes('profile_success') %}
        <p class="customer-alert customer-alert--success">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('profile_error') %}
        <p class="customer-alert customer-alert--error">{{ message }}</p>
    {% endfor %}

    {# Mise à jour des données réutilisées pour identifier le client et préremplir ses commandes. #}
    <form class="customer-profile-form" method="post" action="{{ path('customer_profile') }}">
        {# Le même jeton protège toutes les actions authentifiées de l’espace client. #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_action') }}">
        {# Distingue ce traitement de celui du mot de passe, les deux formulaires ciblant la même route. #}
        <input type="hidden" name="profile_action" value="information">
        <div class="customer-profile-columns">
            <section class="customer-profile-card-panel">
                <h2>Informations personnelles</h2>

                <div class="customer-profile-grid customer-profile-grid--two">
                    <label>
                        <span>Prénom</span>
                        <input type="text" name="prenom" value="{{ customer.prenom }}" placeholder="{{ customer.prenom }}" autocomplete="given-name" required>
                    </label>

                    <label>
                        <span>Nom</span>
                        <input type="text" name="nom" value="{{ customer.nom }}" placeholder="{{ customer.nom }}" autocomplete="family-name" required>
                    </label>
                </div>

                {# L’adresse électronique sert également d’identifiant de connexion. #}
                <label>
                    <span>Email</span>
                    <input type="email" name="email" value="{{ customer.email }}" placeholder="{{ customer.email }}" autocomplete="email" required>
                </label>

                <label>
                    <span>Numéro de téléphone</span>
                    <input type="tel" name="telephone" value="{{ customer.telephone }}" placeholder="{{ customer.telephone }}" autocomplete="tel" required>
                </label>
            </section>

            {# Adresse proposée par défaut lors de la préparation d’une nouvelle commande. #}
            <section class="customer-profile-card-panel">
                <h2>Adresse de livraison par défaut</h2>

                <label>
                    <span>Adresse</span>
                    <input type="text" name="adresse_postale" value="{{ customer.adresse_postale }}" placeholder="{{ customer.adresse_postale }}" autocomplete="street-address" required>
                </label>

                <div class="customer-profile-grid customer-profile-grid--two">
                    <label>
                        <span>Code postal</span>
                        <input type="text" name="code_postal" value="{{ customer.code_postal }}" placeholder="{{ customer.code_postal }}" autocomplete="postal-code" required>
                    </label>

                    <label>
                        <span>Ville</span>
                        <input type="text" name="ville" value="{{ customer.ville }}" placeholder="{{ customer.ville }}" autocomplete="address-level2" required>
                    </label>
                </div>

                <p class="customer-profile-note">Cette adresse sera utilisée par défaut lors de vos prochaines commandes.</p>
            </section>
        </div>

        <div class="customer-profile-actions customer-profile-actions--information">
            <button type="submit" class="buttonprimary">Enregistrer les modifications</button>
            <a href="{{ path('customer_account') }}" class="buttonwhite">Annuler</a>
        </div>
    </form>

    {# Changement de mot de passe traité séparément pour ne pas mêler les contrôles de sécurité aux coordonnées. #}
    <form class="customer-profile-form customer-password-form" method="post" action="{{ path('customer_profile') }}">
        {# Protège la demande de changement de mot de passe contre les soumissions provenant d’autres sites. #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_action') }}">
        {# Oriente le contrôleur vers la validation du mot de passe actuel et du nouveau mot de passe. #}
        <input type="hidden" name="profile_action" value="password">

        <section class="customer-profile-card-panel customer-password-panel">
            <h2>Changer mon mot de passe</h2>

            <div class="customer-profile-grid customer-profile-grid--three">
                <label>
                    <span>Mot de passe actuel</span>
                    <span class="auth-password-control">
                        <input type="password" name="current_password" placeholder="Votre mot de passe actuel" autocomplete="current-password" data-password-input>
                        <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Afficher ou masquer le mot de passe actuel">Afficher</button>
                    </span>
                </label>

                <label>
                    <span>Nouveau mot de passe</span>
                    <span class="auth-password-control">
                        <input type="password" name="new_password" placeholder="Tapez votre nouveau mot de passe" autocomplete="new-password" data-password-input>
                        <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Afficher ou masquer le nouveau mot de passe">Afficher</button>
                    </span>
                </label>

                <label>
                    <span>Confirmer le nouveau mot de passe</span>
                    <span class="auth-password-control">
                        <input type="password" name="new_password_confirm" placeholder="Confirmez votre mot de passe" autocomplete="new-password" data-password-input>
                        <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Afficher ou masquer la confirmation du nouveau mot de passe">Afficher</button>
                    </span>
                </label>
            </div>

            {# Règles que le nouveau mot de passe doit respecter côté serveur. #}
            <div class="customer-password-rules">
                <p>Le mot de passe doit contenir au minimum :</p>
                <ul>
                    <li>10 caractères minimum</li>
                    <li>Au minimum 1 caractère spécial</li>
                    <li>Une majuscule</li>
                    <li>Une minuscule</li>
                    <li>Au minimum 1 chiffre</li>
                </ul>
                <a href="{{ path('forgot_password') }}">Mot de passe oublié ?</a>
            </div>
        </section>

        <div class="customer-profile-actions customer-profile-actions--password">
            <button type="submit" class="buttonprimary">Enregistrer mon nouveau mot de passe</button>
        </div>
    </form>
</main>
{% endblock %}


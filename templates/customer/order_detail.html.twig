{% extends 'base.html.twig' %}

{# Détail d’une commande du client : contenu, suivi, modification conditionnelle et dépôt d’avis. #}
{% block title %}Détails des commandes - Vite & Gourmand{% endblock %}

{% block body %}
{# Bandeau commun aux pages publiques et à l’espace client. #}
{% include 'components/_big_title.html.twig' with {
    title: 'Détails des commandes',
    image_alt: 'Détail de commande Vite et Gourmand'
} %}

{# Agrège les lignes de menu pour reconstituer le sous-total et la réduction globale affichés plus bas. #}
{% set firstOrderMenu = orderMenus|first %}
{% set subtotal = 0 %}
{% set discount = 0 %}
{% for orderMenu in orderMenus %}
    {% set subtotal = subtotal + (orderMenu.prix_par_personne * orderMenu.nombre_personnes) %}
    {% set discount = discount + orderMenu.reduction %}
{% endfor %}
{% set hasReview = order.avis_count|default(0) > 0 %}
{# Le statut pilote la couleur du badge et l’accès aux formulaires de modification ou d’avis. #}
{% set statusCode = order.statut_code|default('en_attente') %}
{% set statusClass = statusCode in ['terminee', 'livree'] ? 'badgeterminee' : (statusCode in ['acceptee', 'en_preparation', 'en_livraison'] ? 'badgevalidee' : 'badgeattente') %}

<main class="customer-page order-detail-page">
    <a href="{{ path('customer_orders') }}" class="cart-back-link">← Retour vers mes commandes</a>

    {# Retours du contrôleur après un avis ou une modification de la commande. #}
    {% for message in app.flashes('review_success') %}
        <p class="customer-alert customer-alert--success">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('review_error') %}
        <p class="customer-alert customer-alert--error">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('order_success') %}
        <p class="customer-alert customer-alert--success">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('order_error') %}
        <p class="customer-alert customer-alert--error">{{ message }}</p>
    {% endfor %}

    {# Synthèse de la commande ; le premier menu fournit l’illustration principale. #}
    <section class="order-detail-summary-card">
        {% if firstOrderMenu.menu_image_url|default(null) %}
            <img src="{{ asset(firstOrderMenu.menu_image_url) }}" alt="{{ firstOrderMenu.menu_image_alt ?: firstOrderMenu.nom_menu }}" class="order-detail-summary-card__image">
        {% else %}
            <div class="order-detail-summary-card__image order-detail-summary-card__image--empty"></div>
        {% endif %}

        <div class="order-detail-summary-card__content">
            <h2>Commande n°{{ order.commande_id }}</h2>
            <p>Commandée le {{ order.date_commande ? order.date_commande|date('d/m/Y') : 'date inconnue' }}</p>
            <p>Livraison à domicile : {{ order.adresse_livraison }}, {{ order.code_postal_livraison }} {{ order.ville_livraison }}</p>
            {% for orderMenu in orderMenus %}
                <p>{{ orderMenu.nom_menu }} - {{ orderMenu.nombre_personnes }} personne{{ orderMenu.nombre_personnes > 1 ? 's' : '' }}</p>
            {% endfor %}
            <p>{{ order.prix_total|number_format(2, ',', ' ') }} €</p>
        </div>

        <span class="{{ statusClass }} order-detail-status">{{ order.statut_libelle|default('En attente') }}</span>
    </section>

    {# Les changements restent possibles uniquement avant l’acceptation de la commande par l’équipe. #}
    {% if statusCode == 'en_attente' %}
        <section class="customer-order-edit-card">
            <div class="customer-order-edit-card__intro">
                <h2>Modifier ma commande</h2>
                <p>Vous pouvez modifier cette commande tant qu'elle n'a pas encore &eacute;t&eacute; accept&eacute;e par l'&eacute;quipe.</p>
            </div>

            {# Met à jour la prestation, l’adresse et le nombre de personnes de la commande. #}
            <form method="post" action="{{ path('customer_order_update', { id: order.commande_id }) }}" class="customer-order-edit-form">
                {# Protège la modification contre les soumissions provenant d’autres sites. #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_action') }}">
                <div class="customer-order-edit-grid">
                    <label>
                        <span>Jour de livraison</span>
                        <input type="date" name="date_prestation" value="{{ order.date_prestation ? order.date_prestation|date('Y-m-d') : '' }}" required>
                    </label>
                    <label>
                        <span>Heure de livraison</span>
                        <input type="time" name="heure_de_livraison" min="08:00" max="22:00" value="{{ order.heure_de_livraison ? order.heure_de_livraison|date('H:i') : '' }}" required>
                    </label>
                    <label>
                        <span>Nombre de personnes</span>
                        <input type="number" name="nombre_personnes" min="1" value="{{ order.nombre_personnes }}" required>
                    </label>
                </div>

                <label>
                    <span>Adresse de livraison</span>
                    <input type="text" name="adresse_livraison" value="{{ order.adresse_livraison }}" required>
                </label>

                <div class="customer-order-edit-grid customer-order-edit-grid--two">
                    <label>
                        <span>Code postal</span>
                        <input type="text" name="code_postal_livraison" value="{{ order.code_postal_livraison }}" required>
                    </label>
                    <label>
                        <span>Ville</span>
                        <input type="text" name="ville_livraison" value="{{ order.ville_livraison }}" required>
                    </label>
                </div>

                <button type="submit" class="buttonprimary">Enregistrer les modifications</button>
            </form>

            <hr>

            {# Ajoute une nouvelle ligne de menu à la commande existante. #}
            <form method="post" action="{{ path('customer_order_add_menu', { id: order.commande_id }) }}" class="customer-order-edit-form">
                {# Le même jeton protège toutes les actions authentifiées de l’espace client. #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_action') }}">
                <h3>Ajouter un menu</h3>
                <div class="customer-order-edit-grid customer-order-edit-grid--two">
                    <label>
                        <span>Menu &agrave; ajouter</span>
                        <select name="menu_id" required>
                            <option value="">Choisir un menu</option>
                            {% for menuChoice in availableMenus %}
                                <option value="{{ menuChoice.menu_id }}">
                                    {{ menuChoice.nom_menu }} - {{ menuChoice.prix_par_personne|number_format(2, ',', ' ') }} &euro; / pers.
                                </option>
                            {% endfor %}
                        </select>
                    </label>
                    <label>
                        <span>Nombre de personnes</span>
                        <input type="number" name="nombre_personnes" min="1" value="{{ order.nombre_personnes }}" required>
                    </label>
                </div>
                <button type="submit" class="buttonprimary">Ajouter ce menu</button>
            </form>

            <hr>

            {# Malgré son libellé, cette action cible la route d’annulation de la commande entière. #}
            <div class="customer-order-remove-menu">
                <div>
                    <h3>Supprimer ce menu</h3>
                    <p>Cette action annule uniquement cette ligne de commande.</p>
                </div>
                <form method="post" action="{{ path('customer_order_cancel', { id: order.commande_id }) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce menu de votre commande ?');">
                    {# Protège l’annulation contre les soumissions provenant d’autres sites. #}
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_action') }}">
                    <button type="submit" class="buttonoffwhite">Supprimer ce menu</button>
                </form>
            </div>
        </section>
    {% endif %}

    <hr class="order-detail-separator">

    {# Décomposition financière calculée à partir de toutes les lignes de menu. #}
    <section class="order-detail-section">
        <h2>Récapitulatif de ma commande</h2>

        <div class="order-detail-recap-card">
            <dl>
                {% for orderMenu in orderMenus %}
                    <div>
                        <dt>Menu choisi</dt>
                        <dd>{{ orderMenu.nom_menu }}</dd>
                    </div>
                    <div>
                        <dt>Nombre de personnes</dt>
                        <dd>{{ orderMenu.nombre_personnes }} personne{{ orderMenu.nombre_personnes > 1 ? 's' : '' }}</dd>
                    </div>
                    <div>
                        <dt>Prix unitaire</dt>
                        <dd>{{ orderMenu.prix_par_personne|number_format(2, ',', ' ') }} €</dd>
                    </div>
                    <div>
                        <dt>Total du menu</dt>
                        <dd>{{ orderMenu.prix_menu|number_format(2, ',', ' ') }} €</dd>
                    </div>
                {% endfor %}
                <div>
                    <dt>Sous-total avant réduction</dt>
                    <dd>{{ subtotal|number_format(2, ',', ' ') }} €</dd>
                </div>
                <div>
                    <dt>Réduction</dt>
                    <dd>- {{ discount > 0 ? discount|number_format(2, ',', ' ') : '0,00' }} €</dd>
                </div>
                <div>
                    <dt>Frais de livraison</dt>
                    <dd>{{ order.prix_livraison|number_format(2, ',', ' ') }} €</dd>
                </div>
                <div>
                    <dt>Mat&eacute;riel</dt>
                    <dd>{{ order.pret_materiel|default(0) ? 'Demand&eacute;' : 'Non demand&eacute;' }}</dd>
                </div>
                <div>
                    <dt>Total de la commande</dt>
                    <dd>{{ order.prix_total|number_format(2, ',', ' ') }} €</dd>
                </div>
            </dl>
        </div>
    </section>

    <hr class="order-detail-separator">

    {# Composition de chaque menu, limitée aux catégories effectivement renseignées. #}
    <section class="order-detail-section">
        <h2>Détail du menu</h2>

        <div class="order-detail-meal-list">
            {% for orderMenu in orderMenus %}
                <h3>{{ orderMenu.nom_menu }}</h3>
                {% for category, item in orderMenu.mealItems %}
                    {% if item %}
                        <article class="order-detail-meal-card">
                            {% if item.image_url %}
                                <img src="{{ asset(item.image_url) }}" alt="{{ item.image_alt ?: item.nom }}">
                            {% else %}
                                <div class="order-detail-meal-card__image-empty"></div>
                            {% endif %}

                            <div>
                                <h4>{{ category }}</h4>
                                <h5>{{ item.nom }}</h5>
                                <p>{{ item.description }}</p>
                            </div>
                        </article>
                    {% endif %}
                {% endfor %}
            {% endfor %}
        </div>
    </section>

    <hr class="order-detail-separator">

    {# Chronologie construite à partir des changements de statut enregistrés. #}
    <section class="order-detail-section">
        <h2>Suivi de la commande</h2>

        <div class="order-detail-timeline">
            {% for step in statusHistory %}
                <article class="order-detail-timeline__step">
                    <span aria-hidden="true"></span>
                    <div>
                        <h3>{{ step.statut_libelle }}</h3>
                        <p>{{ step.date_changement ? step.date_changement|date('d/m/Y à H\\hi') : 'Date non renseignée' }}</p>
                        {% if step.commentaire %}
                            <p>{{ step.commentaire }}</p>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>

    <hr class="order-detail-separator">

    {# L’avis n’est proposé qu’une fois la commande terminée et s’il n’en existe pas déjà un. #}
    <section class="order-detail-review-section">
        <h2>Donnez votre avis</h2>

        {% if statusCode != 'terminee' %}
            <div class="customer-review-card order-detail-review-card">
                <h3>Vous pourrez laisser un avis lorsque cette commande sera termin&eacute;e.</h3>
            </div>
        {% elseif hasReview %}
            <div class="customer-review-card order-detail-review-card">
                <h3>Merci, votre avis a déjà été envoyé pour cette commande.</h3>
            </div>
        {% else %}
            <form class="customer-review-card order-detail-review-card" method="post" action="{{ path('customer_order_detail', { id: order.commande_id }) }}">
                {# Protège l’envoi de l’avis contre les soumissions provenant d’autres sites. #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_action') }}">
                <h3>Comment évalueriez-vous votre expérience ?</h3>
                <input type="hidden" name="commande_id" value="{{ order.commande_id }}">

                {# L’ordre décroissant permet au CSS d’afficher et de surligner les étoiles de droite à gauche. #}
                <fieldset class="customer-rating">
                    <legend>Votre note</legend>
                    <div class="customer-rating-stars">
                        {% for note in 5..1 %}
                            <input id="detail-note-{{ note }}" type="radio" name="note" value="{{ note }}" required>
                            <label for="detail-note-{{ note }}" aria-label="{{ note }} étoile{{ note > 1 ? 's' : '' }}">★</label>
                        {% endfor %}
                    </div>
                </fieldset>

                <label class="customer-review-field">
                    <span>Votre commentaire (facultatif)</span>
                    <textarea name="commentaire" placeholder="Écrivez votre commentaire ici."></textarea>
                </label>

                <button type="submit" class="buttonprimary customer-review-submit">Envoyer mon avis</button>
            </form>
        {% endif %}
    </section>
</main>
{% endblock %}


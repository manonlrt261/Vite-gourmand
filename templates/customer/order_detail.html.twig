{% extends 'base.html.twig' %}

{% block title %}DÃ©tails des commandes - Vite & Gourmand{% endblock %}

{% block body %}
{% include 'components/_big_title.html.twig' with {
    title: 'DÃ©tails des commandes',
    image_alt: 'DÃ©tail de commande Vite et Gourmand'
} %}

{% set subtotal = order.prix_par_personne * order.nombre_personnes %}
{% set discount = subtotal - order.prix_menu %}
{% set hasReview = order.avis_count|default(0) > 0 %}
{% set statusCode = order.statut_code|default('en_attente') %}
{% set statusClass = statusCode in ['terminee', 'livree'] ? 'badgeterminee' : (statusCode in ['acceptee', 'en_preparation', 'en_livraison'] ? 'badgevalidee' : 'badgeattente') %}

<main class="customer-page order-detail-page">
    <a href="{{ path('customer_orders') }}" class="cart-back-link">← Retour vers mes commandes</a>

    {% for message in app.flashes('review_success') %}
        <p class="customer-alert customer-alert--success">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('review_error') %}
        <p class="customer-alert customer-alert--error">{{ message }}</p>
    {% endfor %}

    <section class="order-detail-summary-card">
        {% if order.menu_image_url %}
            <img src="{{ asset(order.menu_image_url) }}" alt="{{ order.menu_image_alt ?: order.nom_menu }}" class="order-detail-summary-card__image">
        {% else %}
            <div class="order-detail-summary-card__image order-detail-summary-card__image--empty"></div>
        {% endif %}

        <div class="order-detail-summary-card__content">
            <h2>Commande nÂ°{{ order.commande_id }}</h2>
            <p>CommandÃ©e le {{ order.date_commande ? order.date_commande|date('d/m/Y') : 'date inconnue' }}</p>
            <p>Livraison Ã  domicile : {{ order.adresse_livraison }}, {{ order.code_postal_livraison }} {{ order.ville_livraison }}</p>
            <p>{{ order.nom_menu }}</p>
            <p>{{ order.nombre_personnes }} personne{{ order.nombre_personnes > 1 ? 's' : '' }}</p>
            <p>{{ order.prix_total|number_format(2, ',', ' ') }} â‚¬</p>
        </div>

        <span class="{{ statusClass }} order-detail-status">{{ order.statut_libelle|default('En attente') }}</span>
    </section>

    <hr class="order-detail-separator">

    <section class="order-detail-section">
        <h2>RÃ©capitulatif de ma commande</h2>

        <div class="order-detail-recap-card">
            <dl>
                <div>
                    <dt>Menu choisi</dt>
                    <dd>{{ order.nom_menu }}</dd>
                </div>
                <div>
                    <dt>Nombre de personnes</dt>
                    <dd>{{ order.nombre_personnes }} personne{{ order.nombre_personnes > 1 ? 's' : '' }}</dd>
                </div>
                <div>
                    <dt>Prix unitaire</dt>
                    <dd>{{ order.prix_par_personne|number_format(2, ',', ' ') }} â‚¬</dd>
                </div>
                <div>
                    <dt>Sous-total</dt>
                    <dd>{{ subtotal|number_format(2, ',', ' ') }} â‚¬</dd>
                </div>
                <div>
                    <dt>RÃ©duction</dt>
                    <dd>- {{ discount > 0 ? discount|number_format(2, ',', ' ') : '0,00' }} â‚¬</dd>
                </div>
                <div>
                    <dt>Frais de livraison</dt>
                    <dd>{{ order.prix_livraison|number_format(2, ',', ' ') }} â‚¬</dd>
                </div>
                <div>
                    <dt>Total de la commande</dt>
                    <dd>{{ order.prix_total|number_format(2, ',', ' ') }} â‚¬</dd>
                </div>
            </dl>
        </div>
    </section>

    <hr class="order-detail-separator">

    <section class="order-detail-section">
        <h2>DÃ©tail du menu</h2>

        <div class="order-detail-meal-list">
            {% for category, item in mealItems %}
                {% if item %}
                    <article class="order-detail-meal-card">
                        {% if item.image_url %}
                            <img src="{{ asset(item.image_url) }}" alt="{{ item.image_alt ?: item.nom }}">
                        {% else %}
                            <div class="order-detail-meal-card__image-empty"></div>
                        {% endif %}

                        <div>
                            <h3>{{ category }}</h3>
                            <h4>{{ item.nom }}</h4>
                            <p>{{ item.description }}</p>
                        </div>
                    </article>
                {% endif %}
            {% endfor %}
        </div>
    </section>

    <hr class="order-detail-separator">

    <section class="order-detail-section">
        <h2>Suivi de la commande</h2>

        <div class="order-detail-timeline">
            {% for step in statusHistory %}
                <article class="order-detail-timeline__step">
                    <span aria-hidden="true"></span>
                    <div>
                        <h3>{{ step.statut_libelle }}</h3>
                        <p>{{ step.date_changement ? step.date_changement|date('d/m/Y Ã  H\\hi') : 'Date non renseignÃ©e' }}</p>
                        {% if step.commentaire %}
                            <p>{{ step.commentaire }}</p>
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </div>
    </section>

    <hr class="order-detail-separator">

    <section class="order-detail-review-section">
        <h2>Donnez votre avis</h2>

        {% if hasReview %}
            <div class="customer-review-card order-detail-review-card">
                <h3>Merci, votre avis a dÃ©jÃ  Ã©tÃ© envoyÃ© pour cette commande.</h3>
            </div>
        {% else %}
            <form class="customer-review-card order-detail-review-card" method="post" action="{{ path('customer_order_detail', { id: order.commande_id }) }}">
                <h3>Comment Ã©valueriez-vous votre expÃ©rience ?</h3>
                <input type="hidden" name="commande_id" value="{{ order.commande_id }}">

                <fieldset class="customer-rating">
                    <legend>Votre note</legend>
                    <div class="customer-rating-stars">
                        {% for note in 5..1 %}
                            <input id="detail-note-{{ note }}" type="radio" name="note" value="{{ note }}" required>
                            <label for="detail-note-{{ note }}" aria-label="{{ note }} Ã©toile{{ note > 1 ? 's' : '' }}">â˜…</label>
                        {% endfor %}
                    </div>
                </fieldset>

                <label class="customer-review-field">
                    <span>Votre commentaire (facultatif)</span>
                    <textarea name="commentaire" placeholder="Ã‰crivez votre commentaire ici."></textarea>
                </label>

                <button type="submit" class="buttonprimary customer-review-submit">Envoyer mon avis</button>
            </form>
        {% endif %}
    </section>
</main>
{% endblock %}


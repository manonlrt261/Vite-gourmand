{% extends 'base.html.twig' %}

{# Titre affiche dans l'onglet du navigateur pour l'historique des commandes. #}
{% block title %}Mes commandes - Vite & Gourmand{% endblock %}

{% block body %}
{# Bandeau principal reutilisable avec le titre de la page. #}
{% include 'components/_big_title.html.twig' with {
    title: 'Mes commandes',
    image_alt: 'Historique des commandes Vite et Gourmand'
} %}

{# Contenu principal de la page qui liste toutes les commandes du client. #}
<main class="customer-page customer-orders-page">
    {# Lien de retour vers le tableau de bord client. #}
    <a href="{{ path('customer_account') }}" class="cart-back-link">← Retour à mon espace client</a>

    {# Introduction de la page. #}
    <section class="customer-profile-intro">
        <h1>Toutes mes commandes</h1>
        <p>Retrouvez ici l'historique de vos commandes passÃ©es chez Vite & Gourmand.</p>
    </section>

    {# Message de succes apres l'envoi d'un avis. #}
    {% for message in app.flashes('review_success') %}
        <p class="customer-alert customer-alert--success">{{ message }}</p>
    {% endfor %}

    {# Message d'erreur lie a l'envoi d'un avis. #}
    {% for message in app.flashes('review_error') %}
        <p class="customer-alert customer-alert--error">{{ message }}</p>
    {% endfor %}

    {# Message de succes apres une action sur une commande. #}
    {% for message in app.flashes('order_success') %}
        <p class="customer-alert customer-alert--success">{{ message }}</p>
    {% endfor %}

    {# Message d'erreur apres une action impossible sur une commande. #}
    {% for message in app.flashes('order_error') %}
        <p class="customer-alert customer-alert--error">{{ message }}</p>
    {% endfor %}

    {# Cas ou le client n'a aucune commande en base. #}
    {% if orders is empty %}
        <section class="cart-empty-card">
            <h2>Aucune commande pour le moment</h2>
            <p>Vos commandes apparaÃ®tront ici dÃ¨s que vous aurez validÃ© un panier.</p>
            <a href="{{ path('menu_index') }}" class="buttonprimary">Voir les menus</a>
        </section>
    {% else %}
        {# Liste complete des commandes du client. #}
        <section class="customer-all-orders">
            {# Boucle sur toutes les commandes du client. #}
            {% for order in orders %}
                {# Preparation du statut, du badge et de l'information avis deja envoye. #}
                {% set statusCode = order.statut_code|default('en_attente') %}
                {% set statusClass = statusCode in ['terminee', 'livree'] ? 'badgeterminee' : (statusCode in ['acceptee', 'en_preparation', 'en_livraison'] ? 'badgevalidee' : 'badgeattente') %}
                {% set hasReview = order.avis_count|default(0) > 0 %}

                {# Ligne recapitulant une commande. #}
                <article class="customer-order-row">
                    {# Informations principales de la commande. #}
                    <div class="customer-order-row__main">
                        <h2>Commande nÂ°{{ order.commande_id }}</h2>
                        <p>{{ order.nom_menu|default('Menu') }}</p>
                        <p>CommandÃ©e le {{ order.date_commande ? order.date_commande|date('d/m/Y') : 'date inconnue' }}</p>
                        {% if order.date_prestation %}
                            <p>Prestation le {{ order.date_prestation|date('d/m/Y') }}</p>
                        {% endif %}
                    </div>

                    {# Badge de statut et montant total. #}
                    <span class="{{ statusClass }}">{{ order.statut_libelle|default('En attente') }}</span>
                    <strong>{{ order.prix_total|default(0)|number_format(2, ',', ' ') }} â‚¬</strong>

                    {# Actions disponibles sur la commande. #}
                    <div class="customer-order-row__actions">
                        <a href="{{ path('customer_order_detail', { id: order.commande_id }) }}" class="buttonprimary">Voir le dÃ©tail</a>
                        {# Annulation possible uniquement tant que la commande est en attente. #}
                        {% if statusCode == 'en_attente' %}
                            <form method="post" action="{{ path('customer_order_cancel', { id: order.commande_id }) }}" onsubmit="return confirm('Voulez-vous vraiment annuler cette commande ?');">
                                {# Token CSRF : protege l annulation de commande. #}
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_action') }}">
                                <button type="submit" class="buttonoffwhite" aria-label="Annuler la commande n&deg;{{ order.commande_id }}">Annuler</button>
                            </form>
                        {% endif %}
                        {# L'avis peut etre laisse seulement si la commande est terminee et sans avis existant. #}
                        {% if statusCode == 'terminee' and not hasReview %}
                            <button
                                type="button"
                                class="buttonwhite"
                                data-review-open
                                data-order-id="{{ order.commande_id }}"
                                data-order-label="Commande nÂ°{{ order.commande_id }}{% if order.nom_menu %} - {{ order.nom_menu }}{% endif %}"
                                aria-label="Laisser un avis pour la commande n&deg;{{ order.commande_id }}"
                            >
                                Laisser un avis
                            </button>
                        {% else %}
                            {# Indication affichee si un avis a deja ete envoye pour cette commande. #}
                            {% if hasReview %}
                                <span class="customer-review-done">Avis envoyÃ©</span>
                            {% endif %}
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </section>
    {% endif %}
</main>

{# Fenetre modale permettant de laisser un avis depuis la liste des commandes. #}
<div class="customer-review-modal" data-review-modal hidden>
    {# Overlay permettant de fermer la fenetre en cliquant a l'exterieur. #}
    <div class="customer-review-modal__overlay" data-review-close></div>

    {# Boite de dialogue contenant le formulaire d'avis. #}
    <section class="customer-review-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="review-modal-title">
        {# Bouton de fermeture de la fenetre. #}
        <button type="button" class="customer-review-modal__close" aria-label="Fermer la fenÃªtre" data-review-close>Ã—</button>

        {# Formulaire d'avis envoye vers la page Mes commandes. #}
        <form class="customer-review-card customer-review-card--modal" method="post" action="{{ path('customer_orders') }}">
            {# Token CSRF : protege l envoi d un avis client. #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_action') }}">
            <h3 id="review-modal-title">Comment Ã©valueriez-vous votre expÃ©rience ?</h3>

            {# Identifiant de commande rempli par JavaScript au clic sur Laisser un avis. #}
            <input type="hidden" name="commande_id" data-review-order-id>
            <p class="customer-review-modal__order" data-review-order-label></p>

            {# Note obligatoire de 1 a 5 etoiles. #}
            <fieldset class="customer-rating">
                <legend>Votre note</legend>
                <div class="customer-rating-stars">
                    {% for note in 5..1 %}
                        <input id="orders-note-{{ note }}" type="radio" name="note" value="{{ note }}" required>
                        <label for="orders-note-{{ note }}" aria-label="{{ note }} Ã©toile{{ note > 1 ? 's' : '' }}">â˜…</label>
                    {% endfor %}
                </div>
            </fieldset>

            {# Commentaire facultatif associe a l'avis. #}
            <label class="customer-review-field">
                <span>Votre commentaire (facultatif)</span>
                <textarea name="commentaire" placeholder="Ã‰crivez votre commentaire ici."></textarea>
            </label>

            {# Bouton d'envoi de l'avis. #}
            <button type="submit" class="buttonprimary customer-review-submit">Envoyer mon avis</button>
        </form>
    </section>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Script qui ouvre/ferme la modale d'avis et pre-remplit la commande concernee. #}
    <script src="{{ asset('assets/scripts/customer-orders.js') }}" defer></script>
{% endblock %}


{% extends 'base.html.twig' %}

{# Historique complet des commandes du client, avec les actions autorisées selon leur statut. #}
{% block title %}Mes commandes - Vite & Gourmand{% endblock %}

{% block body %}
{# Bandeau commun aux pages publiques et à l’espace client. #}
{% include 'components/_big_title.html.twig' with {
    title: 'Mes commandes',
    image_alt: 'Historique des commandes Vite et Gourmand'
} %}

<main class="customer-page customer-orders-page">
    <a href="{{ path('customer_account') }}" class="cart-back-link">← Retour à mon espace client</a>

    <section class="customer-profile-intro">
        <h1>Toutes mes commandes</h1>
        <p>Retrouvez ici l'historique de vos commandes passées chez Vite & Gourmand.</p>
    </section>

    {# Retours du contrôleur après un avis ou une action sur une commande. #}
    {% for message in app.flashes('review_success') %}
        <p class="customer-alert customer-alert--success">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('review_error') %}
        <p class="customer-alert customer-alert--error">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('order_success') %}
        <p class="customer-alert customer-alert--success">{{ message }}</p>
    {% endfor %}

    {% for message in app.flashes('order_error') %}
        <p class="customer-alert customer-alert--error">{{ message }}</p>
    {% endfor %}

    {# L’état vide redirige le client vers le catalogue pour démarrer une commande. #}
    {% if orders is empty %}
        <section class="cart-empty-card">
            <h2>Aucune commande pour le moment</h2>
            <p>Vos commandes apparaîtront ici dès que vous aurez validé un panier.</p>
            <a href="{{ path('menu_index') }}" class="buttonprimary">Voir les menus</a>
        </section>
    {% else %}
        <section class="customer-all-orders">
            {% for order in orders %}
                {# Le statut détermine à la fois la présentation et les actions disponibles. #}
                {% set statusCode = order.statut_code|default('en_attente') %}
                {% set statusClass = statusCode in ['terminee', 'livree'] ? 'badgeterminee' : (statusCode in ['acceptee', 'en_preparation', 'en_livraison'] ? 'badgevalidee' : 'badgeattente') %}
                {% set hasReview = order.avis_count|default(0) > 0 %}

                <article class="customer-order-row">
                    <div class="customer-order-row__main">
                        <h2>Commande n°{{ order.commande_id }}</h2>
                        <p>{{ order.nom_menu|default('Menu') }}</p>
                        <p>Commandée le {{ order.date_commande ? order.date_commande|date('d/m/Y') : 'date inconnue' }}</p>
                        {% if order.date_prestation %}
                            <p>Prestation le {{ order.date_prestation|date('d/m/Y') }}</p>
                        {% endif %}
                    </div>

                    <span class="{{ statusClass }}">{{ order.statut_libelle|default('En attente') }}</span>
                    <strong>{{ order.prix_total|default(0)|number_format(2, ',', ' ') }} €</strong>

                    <div class="customer-order-row__actions">
                        <a href="{{ path('customer_order_detail', { id: order.commande_id }) }}" class="buttonprimary">Voir le détail</a>
                        {# L’annulation est proposée uniquement avant l’acceptation de la commande. #}
                        {% if statusCode == 'en_attente' %}
                            <form method="post" action="{{ path('customer_order_cancel', { id: order.commande_id }) }}" onsubmit="return confirm('Voulez-vous vraiment annuler cette commande ?');">
                                {# Protège l’annulation contre les soumissions provenant d’autres sites. #}
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_action') }}">
                                <button type="submit" class="buttonoffwhite" aria-label="Annuler la commande n&deg;{{ order.commande_id }}">Annuler</button>
                            </form>
                        {% endif %}
                        {# Un seul avis est autorisé, et seulement après la fin de la commande. #}
                        {% if statusCode == 'terminee' and not hasReview %}
                            <button
                                type="button"
                                class="buttonwhite"
                                data-review-open
                                data-order-id="{{ order.commande_id }}"
                                data-order-label="Commande n°{{ order.commande_id }}{% if order.nom_menu %} - {{ order.nom_menu }}{% endif %}"
                                aria-label="Laisser un avis pour la commande n&deg;{{ order.commande_id }}"
                            >
                                Laisser un avis
                            </button>
                        {% else %}
                            {% if hasReview %}
                                <span class="customer-review-done">Avis envoyé</span>
                            {% endif %}
                        {% endif %}
                    </div>
                </article>
            {% endfor %}
        </section>
    {% endif %}
</main>

{# Modale d’avis alimentée avec la commande sélectionnée sans quitter l’historique. #}
<div class="customer-review-modal" data-review-modal hidden>
    <div class="customer-review-modal__overlay" data-review-close></div>

    <section class="customer-review-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="review-modal-title">
        <button type="button" class="customer-review-modal__close" aria-label="Fermer la fenêtre" data-review-close>×</button>

        <form class="customer-review-card customer-review-card--modal" method="post" action="{{ path('customer_orders') }}">
            {# Protège l’envoi de l’avis contre les soumissions provenant d’autres sites. #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('customer_action') }}">
            <h3 id="review-modal-title">Comment évalueriez-vous votre expérience ?</h3>

            {# JavaScript injecte ici l’identifiant et le libellé du bouton qui a ouvert la modale. #}
            <input type="hidden" name="commande_id" data-review-order-id>
            <p class="customer-review-modal__order" data-review-order-label></p>

            {# L’ordre décroissant permet au CSS d’afficher et de surligner les étoiles de droite à gauche. #}
            <fieldset class="customer-rating">
                <legend>Votre note</legend>
                <div class="customer-rating-stars">
                    {% for note in 5..1 %}
                        <input id="orders-note-{{ note }}" type="radio" name="note" value="{{ note }}" required>
                        <label for="orders-note-{{ note }}" aria-label="{{ note }} étoile{{ note > 1 ? 's' : '' }}">★</label>
                    {% endfor %}
                </div>
            </fieldset>

            <label class="customer-review-field">
                <span>Votre commentaire (facultatif)</span>
                <textarea name="commentaire" placeholder="Écrivez votre commentaire ici."></textarea>
            </label>

            <button type="submit" class="buttonprimary customer-review-submit">Envoyer mon avis</button>
        </form>
    </section>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Gère l’ouverture, la fermeture et le préremplissage de la modale d’avis. #}
    <script src="{{ asset('assets/scripts/customer-orders.js') }}" defer></script>
{% endblock %}


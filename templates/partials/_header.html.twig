{# Détermine la variante du bandeau et sa destination à partir du rôle en session. #}
{% set connectedUser = app.session.get('utilisateur') %}
{% set roleLibelle = connectedUser.role_libelle|default('') %}
{% set roleId = connectedUser.role_id|default(0) %}
{# L’identifiant complète le libellé afin de tolérer l’absence de l’une des deux valeurs. #}
{% set isAdminHeader = roleLibelle == 'administrateur' or roleId == 3 %}
{# Conserve les libellés alternatifs du rôle employé présents dans les données historiques. #}
{% set isEmployeeHeader = roleLibelle in ['employe', 'employé', 'administrateur'] or roleId in [2, 3] %}
{% set dashboardRoute = isAdminHeader ? 'admin_dashboard' : 'employee_dashboard' %}

{# Bandeau réservé aux espaces employé et administrateur. #}
{% if isEmployeeHeader %}
    <header class="employee-header">
        <a href="{{ path(dashboardRoute) }}" class="employee-header__brand" aria-label="Tableau de bord Vite et Gourmand">
            <img
                src="{{ asset('assets/logo.png') }}"
                alt="Logo Vite et Gourmand"
                class="employee-header__logo"
            >

            <span class="employee-header__title">Vite et gourmand</span>
        </a>

        {# Le bouton expose son état aux technologies d’assistance ; le script le met à jour à l’ouverture. #}
        <div class="employee-header__actions">
            <a href="{{ path(dashboardRoute) }}" class="employee-header__dashboard">Tableau de bord</a>
            <button class="employee-header__burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="employee-menu-overlay" data-employee-menu-open>
                <svg aria-hidden="true" viewBox="0 0 16 16" focusable="false">
                    <path d="M2 4h12M2 8h12M2 12h12" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
            </button>
        </div>
    </header>

    {# Menu superposé masqué par défaut, piloté via les attributs data-* par le script du bandeau. #}
    <div class="employee-menu-overlay" id="employee-menu-overlay" hidden data-employee-menu-overlay>
        <div class="employee-menu-panel" role="dialog" aria-modal="true" aria-label="Menu">
            {# En-tête du panneau reprenant l’accès au tableau de bord et l’action de fermeture. #}
            <div class="employee-menu-panel__top">
                <a href="{{ path(dashboardRoute) }}" class="employee-header__brand" aria-label="Tableau de bord Vite et Gourmand">
                    <img
                        src="{{ asset('assets/logo.png') }}"
                        alt="Logo Vite et Gourmand"
                        class="employee-header__logo"
                    >

                    <span class="employee-header__title">Vite et gourmand</span>
                </a>

                <div class="employee-header__actions">
                    <a href="{{ path(dashboardRoute) }}" class="employee-header__dashboard">Tableau de bord</a>
                    <button class="employee-header__close" type="button" aria-label="Fermer le menu" data-employee-menu-close>
                        <svg aria-hidden="true" viewBox="0 0 16 16" focusable="false">
                            <path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                        </svg>
                    </button>
                </div>
            </div>

            {# Outils communs aux employés et aux administrateurs. #}
            <nav class="employee-menu-panel__nav" aria-label="Navigation">
                <a href="{{ path(dashboardRoute) }}">Mon espace</a>
                <a href="{{ path('employee_orders') }}">Gestion des commandes</a>
                <a href="{{ path('employee_menus') }}">Gestion des menus et plats</a>
                <a href="{{ path('employee_hours') }}">Gestion des horaires</a>
                <a href="{{ path('employee_reviews') }}">Gestion des avis clients</a>
                <a href="{{ path('employee_messages') }}">Messagerie</a>
                {# Fonctions de pilotage réservées au rôle administrateur. #}
                {% if isAdminHeader %}
                    <a href="{{ path('admin_employees') }}">Gestion des employ&eacute;s</a>
                    <a href="{{ path('admin_orders_by_menu') }}">Commandes par menu</a>
                    <a href="{{ path('admin_revenue_by_menu') }}">Chiffre d'affaires par menu</a>
                {% endif %}
                <a href="{{ path('logout') }}">D&eacute;connexion</a>
            </nav>
        </div>
    </div>
{% else %}
    {# Bandeau public affiché aux visiteurs et aux clients. #}
    <header class="header-desktop">
        <a href="{{ path('home_show') }}" class="header-brand" aria-label="Accueil Vite et Gourmand">
            <img
                src="{{ asset('assets/logo.png') }}"
                alt="Logo Vite et Gourmand"
                class="header-logo"
            >

            <span class="header-title">Vite et Gourmand</span>
        </a>

        {# Commande du menu mobile ; aria-controls relie explicitement le bouton au panneau ciblé. #}
        <button class="header-mobile-burger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="public-mobile-menu-overlay" data-public-menu-open>
            <svg aria-hidden="true" viewBox="0 0 16 16" focusable="false">
                <path d="M2 4h12M2 8h12M2 12h12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
        </button>

        {# Navigation principale adaptée à l’état de la session client. #}
        <nav class="header-nav" aria-label="Navigation principale">
            <a href="{{ path('home_show') }}">Accueil</a>
            <a href="{{ path('menu_index') }}">Menus</a>
            <a href="{{ path('contact_index') }}">Contact</a>
            {% if app.session.get('utilisateur_id') %}
                <a href="{{ path('customer_account') }}">Mon compte</a>
                <a href="{{ path('logout') }}">D&eacute;connexion</a>
            {% else %}
                <a href="{{ path('login') }}">Connexion</a>
            {% endif %}
        </nav>

        {# Accès direct au panier, représenté visuellement par une icône. #}
        <a href="{{ path('cart_index') }}" class="header-cart" aria-label="Mon panier">
            <svg class="header-cart__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M5.757 1.071a.5.5 0 0 1 .172.686L3.383 6h9.234L10.07 1.757a.5.5 0 1 1 .858-.514L13.783 6H15a1 1 0 0 1 .99 1.141l-.825 5.775A2.5 2.5 0 0 1 12.69 15H3.31a2.5 2.5 0 0 1-2.475-2.084L.01 7.141A1 1 0 0 1 1 6h1.217L5.07 1.243a.5.5 0 0 1 .686-.172ZM1 7l.825 5.775A1.5 1.5 0 0 0 3.31 14h9.38a1.5 1.5 0 0 0 1.485-1.225L15 7H1Z"/>
            </svg>
        </a>
    </header>

    {# Variante mobile masquée par défaut et pilotée par le script via les attributs data-*. #}
    <div class="public-menu-overlay" id="public-mobile-menu-overlay" hidden data-public-menu-overlay>
        <div class="public-menu-panel" role="dialog" aria-modal="true" aria-label="Menu principal mobile">
            {# Reprend l’identité du bandeau et remplace le bouton d’ouverture par la fermeture. #}
            <div class="public-menu-panel__top">
                <a href="{{ path('home_show') }}" class="header-brand" aria-label="Accueil Vite et Gourmand">
                    <img
                        src="{{ asset('assets/logo.png') }}"
                        alt="Logo Vite et Gourmand"
                        class="header-logo"
                    >

                    <span class="header-title">Vite et Gourmand</span>
                </a>

                <button class="public-menu-panel__close" type="button" aria-label="Fermer le menu" data-public-menu-close>
                    <svg aria-hidden="true" viewBox="0 0 16 16" focusable="false">
                        <path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                    </svg>
                </button>
            </div>

            {# Reprend les liens publics et ajoute le panier dans le panneau mobile. #}
            <nav class="public-menu-panel__nav" aria-label="Navigation mobile">
                <a href="{{ path('home_show') }}">Accueil</a>
                <a href="{{ path('menu_index') }}">Menus</a>
                <a href="{{ path('contact_index') }}">Contact</a>
                {% if app.session.get('utilisateur_id') %}
                    <a href="{{ path('customer_account') }}">Mon compte</a>
                    <a href="{{ path('logout') }}">D&eacute;connexion</a>
                {% else %}
                    <a href="{{ path('login') }}">Connexion</a>
                {% endif %}
                <a href="{{ path('cart_index') }}">Panier</a>
            </nav>
        </div>
    </div>
{% endif %}

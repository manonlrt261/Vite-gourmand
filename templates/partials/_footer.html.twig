<footer class="footer-desktop">
    <div class="footer-hours">
        <h2 class="footer-title">Horaires :</h2>

        <p class="footer-text">
            {% for line in business_hours_lines() %}
                {{ line }}{% if not loop.last %}<br>{% endif %}
            {% endfor %}
        </p>
    </div>

    <div class="footer-brand">
        <p class="footer-name">Vite & Gourmand</p>

        <nav class="footer-legal" aria-label="Liens legaux">
            <a href="#">Mentions legales</a>
            <a href="#">CGV</a>
        </nav>
    </div>

    <nav class="footer-nav" aria-label="Navigation footer">
        <a href="{{ path('home_show') }}">Accueil</a>
        <a href="{{ path('menu_index') }}">Menus</a>
        <a href="{{ path('contact_index') }}">Contact</a>
        {% if app.session.get('utilisateur_id') %}
            <a href="{{ path('customer_account') }}">Mon compte</a>
            <a href="{{ path('logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('login') }}">Connexion</a>
        {% endif %}
    </nav>
</footer>

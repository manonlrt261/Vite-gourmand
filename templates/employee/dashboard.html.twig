{% extends 'base.html.twig' %}

{# Tableau de bord employé : raccourcis de gestion, commandes récentes et avis à modérer. #}
{% block title %}Mon espace employe - Vite & Gourmand{% endblock %}

{% block body %}
    {# Bandeau principal réutilisable avec le titre de l'espace employé. #}
    {% include 'components/_big_title.html.twig' with {
        title: 'Mon espace employé',
        image: asset('assets/bigtittle.png'),
        image_alt: 'Plat raffine Vite et Gourmand'
    } %}

    {# Contenu principal du tableau de bord employé. #}
    <main class="employee-dashboard-page" data-employee-dashboard>
        {# Accès directs aux principales fonctions opérationnelles. #}
        <section class="employee-action-grid" aria-label="Actions principales">
            {# Accès à la gestion des commandes clients. #}
            <article class="employee-action-card">
                <h2>Les commandes</h2>
                <p>Consultez et gérez<br>toutes vos commandes</p>
                <a href="{{ path('employee_orders') }}" class="buttonprimary employee-card-button">Accéder</a>
            </article>

            {# Accès à la gestion des menus, plats et stocks. #}
            <article class="employee-action-card">
                <h2>Menus &amp; plats</h2>
                <p>Modifiez les menus,<br>les plats et les stocks</p>
                <a href="{{ path('employee_menus') }}" class="buttonprimary employee-card-button">Accéder</a>
            </article>

            {# Accès à la gestion des horaires et fermetures. #}
            <article class="employee-action-card">
                <h2>Horaires</h2>
                <p>Consultez et gérez<br>les horaires</p>
                <a href="{{ path('employee_hours') }}" class="buttonprimary employee-card-button">Accéder</a>
            </article>

            {# Accès à la modération des avis clients. #}
            <article class="employee-action-card">
                <h2>Avis clients</h2>
                <p>Consultez et répondez<br>aux avis clients</p>
                <a href="{{ path('employee_reviews') }}" class="buttonprimary employee-card-button">Accéder</a>
            </article>
        </section>

        {# Zone principale : commandes récentes à gauche et avis en attente à droite. #}
        <section class="employee-dashboard-content">
            <div class="employee-orders-zone">
                {# En-tête de la section des commandes avec un lien vers la page complète. #}
                <div class="employee-section-heading">
                    <h2>Commandes</h2>
                    <a href="{{ path('employee_orders') }}">Voir toutes les commandes →</a>
                </div>

                {# Filtres appliqués côté navigateur aux cartes déjà rendues. #}
                <form class="employee-order-filters" data-employee-order-filters>
                    {# Recherche par numéro de commande. #}
                    <label>
                        <span>Rechercher une commande</span>
                        <input type="text" name="orders" placeholder="Ex : 1, 2, 3" autocomplete="off">
                    </label>

                    {# Filtre par statut de commande, alimenté par la base. #}
                    <label>
                        <span>Statut</span>
                        <select name="status">
                            <option value="">Tous les statuts</option>
                            {# Liste des statuts possibles. #}
                            {% for status in statuses %}
                                <option value="{{ status.code }}">{{ status.libelle }}</option>
                            {% endfor %}
                        </select>
                    </label>

                    {# Filtre par période. #}
                    <label>
                        <span>Période</span>
                        <select name="period">
                            <option value="">Toutes les périodes</option>
                            <option value="last_10_days">10 derniers jours</option>
                            <option value="last_month">Mois dernier</option>
                            <option value="last_6_months">6 mois avant</option>
                            <option value="current_year">Année entière</option>
                            <option value="previous_year">Année d'avant</option>
                            <option value="two_years_ago">Année d'encore avant</option>
                        </select>
                    </label>

                    {# Boutons pour appliquer ou réinitialiser les filtres. #}
                    <div class="employee-filter-actions">
                        <button type="submit" class="buttonprimary employee-filter-submit" aria-label="Appliquer les filtres des commandes">Valider</button>
                        <button type="reset" class="buttonwhite employee-filter-reset">Réinitialiser</button>
                    </div>
                </form>

                {# Liste des commandes affichées sur le tableau de bord. #}
                <div class="employee-orders-list" data-employee-orders-list>
                    {# Message si aucune commande n'existe encore. #}
                    {% if orders is empty %}
                        <p class="employee-empty">Aucune commande pour le moment.</p>
                    {% else %}
                        {# Boucle sur les commandes récentes. #}
                        {% for order in orders %}
                            {# Regroupe les statuts terminaux et intermédiaires sous les styles disponibles. #}
                            {% set statusClass = order.statut_code == 'terminee' or order.statut_code == 'livree' ? 'badgeterminee' : (order.statut_code == 'en_attente' ? 'badgeattente' : 'badgevalidee') %}
                            {# Carte résumée d'une commande, avec les données utiles aux filtres JavaScript. #}
                            <article
                                class="cardvieworderemployee employee-order-card"
                                data-order-card
                                data-order-id="{{ order.commande_id }}"
                                data-order-status="{{ order.statut_code }}"
                                data-order-date="{{ order.date_commande ? order.date_commande|date('Y-m-d') : '' }}"
                                {% if loop.index > 4 %}hidden{% endif %}
                            >
                                <div class="cardvieworderemployee-infos">
                                    <h3 class="cardvieworderemployee-title">Commande n°{{ order.commande_id }}</h3>
                                    <p class="cardvieworderemployee-client">
                                        {{ order.prenom|default('Client') }} {{ order.nom|default('') }}
                                        {% if order.nom_menu %} · {{ order.nom_menu }}{% endif %}
                                    </p>
                                    <p class="cardvieworderemployee-date">
                                        Commandée le {{ order.date_commande ? order.date_commande|date('d/m/Y') : 'date inconnue' }}
                                    </p>
                                </div>

                                {# Le sélecteur conserve l'apparence d'un badge tout en autorisant un changement direct de statut. #}
                                <form method="post" action="{{ path('employee_order_advance_status', { id: order.commande_id }) }}" data-dashboard-order-status-form>
                                    {# Le jeton CSRF sécurise le changement de statut de la commande. #}
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                                    <select
                                        name="status"
                                        class="{{ statusClass }} cardvieworderemployee-status"
                                        data-dashboard-order-status-select
                                        aria-label="Choisir le statut de la commande n°{{ order.commande_id }}"
                                    >
                                        {% for status in statuses %}
                                            {% if status.code != 'annulee' or order.statut_code == 'annulee' %}
                                                <option value="{{ status.code }}" {% if status.code == order.statut_code %}selected{% endif %}>
                                                    {{ status.libelle }}
                                                </option>
                                            {% endif %}
                                        {% endfor %}
                                    </select>
                                </form>
                            </article>
                        {% endfor %}
                    {% endif %}
                    {# Message affiché quand les filtres ne trouvent aucun résultat. #}
                    <p class="employee-empty" data-employee-orders-empty hidden>Aucune commande ne correspond à votre recherche.</p>
                </div>
            </div>

            {# Colonne latérale affichant les derniers avis en attente de modération. #}
            <aside class="employee-reviews-zone">
                {# En-tête des avis avec un lien vers la page complète de modération. #}
                <div class="employee-section-heading employee-section-heading--reviews">
                    <h2>Avis en attente</h2>
                    <a href="{{ path('employee_reviews') }}">Voir tous les avis →</a>
                </div>

                <div class="employee-review-list">
                    {# Message si aucun avis n'est en attente. #}
                    {% if pendingReviews is empty %}
                        <p class="employee-empty">Aucun avis en attente.</p>
                    {% else %}
                        {# Boucle sur les avis en attente. #}
                        {% for review in pendingReviews %}
                            {# Carte courte d'un avis client. #}
                            <article class="latestreview">
                                <header class="latestreview-header">
                                    <h3 class="latestreview-name">{{ review.prenom|default('Client') }} {{ review.nom|default('') }}</h3>
                                    <p class="latestreview-rating">Note {{ review.note }}/5 · Commande n°{{ review.commande_id }}</p>
                                </header>

                                <p class="latestreview-text">{{ review.commentaire|default('Aucun commentaire laissé.') }}</p>

                                <div class="latestreview-actions">
                                    {# Formulaire pour refuser l'avis. #}
                                    <form method="post" action="{{ path('employee_review_status', { id: review.avis_id }) }}" data-dashboard-review-action>
                                        {# Le jeton CSRF sécurise le refus de l'avis. #}
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                                        <input type="hidden" name="action" value="refuse">
                                        <button type="submit" class="buttonrefuse latestreview-refuse" aria-label="Refuser l'avis n&deg;{{ review.avis_id }}">Refuser</button>
                                    </form>

                                    {# Formulaire pour accepter l'avis. #}
                                    <form method="post" action="{{ path('employee_review_status', { id: review.avis_id }) }}" data-dashboard-review-action>
                                        {# Le jeton CSRF sécurise la validation de l'avis. #}
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                                        <input type="hidden" name="action" value="accept">
                                        <button type="submit" class="buttonaccept latestreview-accept" aria-label="Valider l'avis n&deg;{{ review.avis_id }}">Valider</button>
                                    </form>
                                </div>
                            </article>
                        {% endfor %}
                    {% endif %}
                </div>
            </aside>
        </section>

        {# Bouton de déconnexion de l'employé. #}
        <div class="employee-dashboard-logout">
            <a href="{{ path('logout') }}" class="buttonprimary">Déconnexion</a>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Gère les filtres et les actions asynchrones du tableau de bord employé. #}
    <script src="{{ asset('assets/scripts/employee-dashboard.js') }}" defer></script>
{% endblock %}

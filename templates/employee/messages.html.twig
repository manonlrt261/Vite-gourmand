{% extends 'base.html.twig' %}

{# Messagerie de suivi des demandes clients et des retours de matériel. #}
{% block title %}Messagerie - Vite & Gourmand{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Chargé en amont pour gérer les onglets et les actions asynchrones de la messagerie. #}
    <script src="{{ asset('assets/scripts/employee-messages.js') }}" defer></script>
{% endblock %}

{% block body %}
    {# Bandeau principal réutilisable avec le titre de la page. #}
    {% include 'components/_big_title.html.twig' with {
        title: 'Messagerie',
        image: asset('assets/bigtittle.png'),
        image_alt: 'Messagerie Vite et Gourmand'
    } %}

    {# Contenu principal de la messagerie employé/administrateur. #}
    <main class="employee-messages-page">
        {# Lien de retour adapté au rôle connecté. #}
        {% include 'components/_workspace_back_link.html.twig' %}

        {# Introduction de la page. #}
        <section class="employee-messages-intro">
            <h1>Messages clients</h1>
            <p>Consultez les demandes envoyées depuis la page contact, répondez aux clients et classez les messages.</p>
        </section>

        {# Région annoncée aux technologies d'assistance après chaque action asynchrone. #}
        <div class="employee-message-feedback" data-message-feedback hidden></div>

        {# Messages de succès ou d'erreur après une action classique. #}
        {% for message in app.flashes('message_success') %}
            <p class="contact-alert contact-alert--success">{{ message }}</p>
        {% endfor %}

        {% for message in app.flashes('message_error') %}
            <p class="contact-alert contact-alert--error">{{ message }}</p>
        {% endfor %}

        {# Formulaire d'envoi d'un e-mail de demande de retour de matériel. #}
        <section class="employee-material-email-card">
            <h2>Demande de retour de mat&eacute;riel</h2>
            <p>S&eacute;lectionnez une commande et compl&eacute;tez les informations utiles. Le mail est pr&eacute;par&eacute; automatiquement pour le client.</p>

            <form method="post" action="{{ path('employee_material_return_email') }}" class="employee-material-email-form">
                {# Le jeton CSRF sécurise l'envoi du rappel de retour de matériel. #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">

                {# Sélection de la commande concernée par le retour de matériel. #}
                <label>
                    <span>Commande concern&eacute;e</span>
                    <select name="commande_id" required>
                        <option value="">Sélectionnez</option>
                        {% for order in materialOrders %}
                            <option value="{{ order.commande_id }}">
                                Commande n&deg;{{ order.commande_id }} - {{ order.nom_menu|default('Menu') }} - {{ order.prenom }} {{ order.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </label>

                {# Date limite demandée au client pour retourner le matériel. #}
                <label>
                    <span>Date limite de retour</span>
                    <input type="date" name="date_retour" required>
                </label>

                {# Matériel attendu en retour. #}
                <label class="employee-material-email-form__full">
                    <span>Mat&eacute;riel &agrave; retourner</span>
                    <textarea name="materiel" rows="3" placeholder="Exemple : plats de service, supports, nappage..." required></textarea>
                </label>

                {# Consignes complémentaires facultatives. #}
                <label class="employee-material-email-form__full">
                    <span>Informations compl&eacute;mentaires</span>
                    <textarea name="instructions" rows="3" placeholder="Adresse de retour, horaires, consignes particuli&egrave;res..."></textarea>
                </label>

                <button type="submit" class="buttonprimary">Envoyer la demande</button>
            </form>
        </section>

        {# Onglets de filtrage de la messagerie. #}
        <nav class="employee-message-tabs" aria-label="Filtres messagerie" data-message-tabs>
            <a href="{{ path('employee_messages') }}" class="{{ currentTab == 'active' ? 'is-active' }}" data-message-tab="active">
                Messages reçus <span>{{ counts.active }}</span>
            </a>
            <a href="{{ path('employee_messages', { tab: 'archived' }) }}" class="{{ currentTab == 'archived' ? 'is-active' }}" data-message-tab="archived">
                Voir tous les messages archivés <span>{{ counts.archived }}</span>
            </a>
            <a href="{{ path('employee_messages', { tab: 'deleted' }) }}" class="{{ currentTab == 'deleted' ? 'is-active' }}" data-message-tab="deleted">
                Voir tous les messages supprimés <span>{{ counts.deleted }}</span>
            </a>
            <a href="{{ path('employee_messages', { tab: 'replied' }) }}" class="{{ currentTab == 'replied' ? 'is-active' }}" data-message-tab="replied">
                Messages répondus <span>{{ counts.replied }}</span>
            </a>
        </nav>

        {# Liste des messages correspondant à l'onglet sélectionné. #}
        <section class="employee-message-list" data-message-list>
            {% for contactMessage in messages %}
                {# Carte d'un message client. #}
                <article
                    class="employee-message-card"
                    data-message-card
                    data-message-status="{{ contactMessage.statut|default('nouveau') }}"
                    data-message-has-reply="{{ contactMessage.reponse ? '1' : '0' }}"
                >
                    {# En-tête : numéro, sujet et date du message. #}
                    <header class="employee-message-card__header">
                        <div>
                            <p>Message n°{{ contactMessage.contact_id }}</p>
                            <h2>{{ contactMessage.titre }}</h2>
                        </div>
                        <span>{{ contactMessage.created_at|date('d/m/Y H:i') }}</span>
                    </header>

                    {# Informations rapides : email client et statut du message. #}
                    <div class="employee-message-card__meta">
                        <span>{{ contactMessage.email }}</span>
                        <span>{{ contactMessage.statut|default('nouveau') }}</span>
                    </div>

                    {# Contenu du message envoyé depuis la page de contact. #}
                    <p class="employee-message-card__content">{{ contactMessage.description }}</p>

                    {# Conserve la réponse envoyée avec sa date pour assurer le suivi du message. #}
                    {% if contactMessage.reponse %}
                        <div class="employee-message-reply">
                            <h3>Réponse envoyée</h3>
                            <p>{{ contactMessage.reponse }}</p>
                            {% if contactMessage.responded_at %}
                                <small>
                                    Répondu le {{ contactMessage.responded_at|date('d/m/Y H:i') }}
                                    {% if contactMessage.respondent_prenom or contactMessage.respondent_nom %}
                                        par {{ contactMessage.respondent_prenom }} {{ contactMessage.respondent_nom }}
                                    {% endif %}
                                </small>
                            {% endif %}
                        </div>
                    {% endif %}

                    {# Formulaire de réponse, masqué dans les onglets « Répondus » et « Supprimés ». #}
                    {% if currentTab not in ['replied', 'deleted'] %}
                        <form method="post" action="{{ path('employee_message_reply', { id: contactMessage.contact_id }) }}" class="employee-message-reply-form">
                            {# Le jeton CSRF sécurise l'envoi de la réponse au client. #}
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                            <input type="hidden" name="tab" value="{{ currentTab }}">
                            <label>
                                <span>Répondre au message</span>
                                <textarea name="reponse" rows="4" placeholder="Écrivez votre réponse ici."></textarea>
                            </label>
                            <button type="submit" class="buttonprimary" aria-label="R&eacute;pondre au message n&deg;{{ contactMessage.contact_id }}">Répondre</button>
                        </form>
                    {% endif %}

                    {# Actions disponibles selon l'onglet courant. #}
                    <div class="employee-message-actions">
                        {% if currentTab == 'active' %}
                            <form method="post" action="{{ path('employee_message_archive', { id: contactMessage.contact_id }) }}" data-message-action="archive">
                                {# Le jeton CSRF sécurise l'archivage du message. #}
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                                <input type="hidden" name="tab" value="{{ currentTab }}">
                                <button type="submit" class="buttonoffwhite" aria-label="Archiver le message n&deg;{{ contactMessage.contact_id }}">Archiver</button>
                            </form>
                        {% endif %}

                        {% if currentTab == 'archived' %}
                            <form method="post" action="{{ path('employee_message_unarchive', { id: contactMessage.contact_id }) }}" data-message-action="unarchive">
                                {# Le jeton CSRF sécurise le retour d'un message archivé. #}
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                                <button type="submit" class="buttonprimary" aria-label="D&eacute;placer le message n&deg;{{ contactMessage.contact_id }} dans les messages re&ccedil;us">Déplacer dans messages reçus</button>
                            </form>
                        {% endif %}

                        {% if currentTab == 'deleted' %}
                            <form method="post" action="{{ path('employee_message_restore', { id: contactMessage.contact_id }) }}" data-message-action="restore">
                                {# Le jeton CSRF sécurise la restauration d'un message supprimé. #}
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                                <button
                                    type="submit"
                                    class="buttonprimary"
                                    aria-label="{{ contactMessage.reponse ? 'D&eacute;placer le message n&deg;' ~ contactMessage.contact_id ~ ' dans les messages r&eacute;pondus' : 'D&eacute;placer le message n&deg;' ~ contactMessage.contact_id ~ ' dans les messages re&ccedil;us' }}"
                                >
                                    {{ contactMessage.reponse ? 'Déplacer dans messages répondus' : 'Déplacer dans messages reçus' }}
                                </button>
                            </form>
                        {% endif %}

                        {% if currentTab in ['active', 'archived', 'replied'] %}
                            <form method="post" action="{{ path('employee_message_delete', { id: contactMessage.contact_id }) }}" data-message-action="delete">
                                {# Le jeton CSRF sécurise la suppression du message. #}
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                                <input type="hidden" name="tab" value="{{ currentTab }}">
                                <button type="submit" class="buttonoffwhite" aria-label="Supprimer le message n&deg;{{ contactMessage.contact_id }}">Supprimer</button>
                            </form>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                {# Message affiché si l'onglet ne contient aucun message. #}
                <p class="employee-empty" data-message-empty>Aucun message dans cet onglet.</p>
            {% endfor %}
        </section>

        {# Une fenêtre commune confirme toute suppression avant l'envoi du formulaire concerné. #}
        <div class="employee-message-delete-modal" data-message-delete-modal hidden>
            <div class="employee-message-delete-modal__overlay" data-message-delete-cancel></div>
            <section class="employee-message-delete-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="message-delete-title">
                <button type="button" class="employee-message-delete-modal__close" data-message-delete-cancel aria-label="Fermer la fenêtre de confirmation">&times;</button>
                <h2 id="message-delete-title">Attention</h2>
                <p>Voulez-vous vraiment supprimer ce message ?</p>
                <div class="employee-message-delete-modal__actions">
                    <button type="button" class="buttonprimary" data-message-delete-cancel>Annuler</button>
                    <button type="button" class="buttonoffwhite" data-message-delete-confirm>Supprimer</button>
                </div>
            </section>
        </div>
    </main>
{% endblock %}

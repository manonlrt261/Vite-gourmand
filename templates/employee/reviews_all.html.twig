{% extends 'base.html.twig' %}

{# Titre affiche dans l'onglet du navigateur pour la page de tous les avis. #}
{% block title %}Tous les avis - Vite & Gourmand{% endblock %}

{% block body %}
    {# Bandeau principal reutilisable avec le titre de la page. #}
    {% include 'components/_big_title.html.twig' with {
        title: 'Tous les avis',
        image: asset('assets/bigtittle.png'),
        image_alt: 'Plat Vite et Gourmand'
    } %}

    {# Contenu principal listant les avis par statut. #}
    <main class="employee-reviews-page">
        {# Lien de retour vers la gestion des avis en attente. #}
        <a href="{{ path('employee_reviews') }}" class="cart-back-link">&larr; Retour &agrave; la gestion des avis</a>

        {# Introduction de la page. #}
        <section class="employee-reviews-intro">
            <h1>Tous les avis</h1>
            <p>Retrouvez les avis en attente, les avis accept&eacute;s et les avis refus&eacute;s.</p>
        </section>

        {# Filtres JavaScript communs aux pages d'avis. #}
        <section class="employee-review-filters" data-review-filters>
            {# Recherche par client ou numero de commande. #}
            <label>
                <span class="sr-only">Rechercher un avis par client ou num&eacute;ro de commande</span>
                <input type="search" name="search" placeholder="Rechercher par client ou num&eacute;ro de commande" data-review-search>
            </label>

            <div class="employee-review-filter-row">
                {# Filtre par note. #}
                <label>
                    <span class="sr-only">Filtrer les avis par note</span>
                    <select name="note" data-review-note>
                        <option value="">Note</option>
                        {% for note in 1..5 %}
                            <option value="{{ note }}">{{ note }}/5</option>
                        {% endfor %}
                    </select>
                </label>

                {# Filtre par periode. #}
                <label>
                    <span class="sr-only">Filtrer les avis par p&eacute;riode</span>
                    <select name="period" data-review-period>
                        <option value="">P&eacute;riode</option>
                        <option value="10days">10 derniers jours</option>
                        <option value="previous_month">Mois pr&eacute;c&eacute;dent</option>
                        <option value="6months">6 derniers mois</option>
                        <option value="2025">2025</option>
                        <option value="2024">2024</option>
                        <option value="other">Autres</option>
                    </select>
                </label>

                {# Filtre par menu. #}
                <label>
                    <span class="sr-only">Filtrer les avis par menu</span>
                    <select name="menu" data-review-menu>
                        <option value="">Menu</option>
                        {% for menu in menus %}
                            <option value="{{ menu.menu_id }}">{{ menu.nom_menu }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>

            {# Actions de filtrage. #}
            <div class="employee-review-filter-actions">
                <button type="button" class="buttonprimary" data-review-apply>Appliquer les filtres</button>
                <button type="button" class="buttonoffwhite" data-review-reset>R&eacute;initialiser les filtres</button>
            </div>

            {# Compteur du nombre d'avis affiches. #}
            <p><span data-review-count>{{ reviews|length }}</span> avis affich&eacute;s</p>
        </section>

        {# Separation des avis par statut pour l'affichage. #}
        {% set pendingReviews = reviews|filter(review => review.statut == 'en_attente') %}
        {% set acceptedReviews = reviews|filter(review => review.statut == 'valide') %}
        {% set refusedReviews = reviews|filter(review => review.statut == 'refuse') %}

        {# Liste globale des avis, organisee en trois groupes. #}
        <div class="employee-review-all-list" data-review-list>
            {# Groupe des avis en attente. #}
            <section class="employee-review-group" data-review-group="en_attente">
                <h2>En attente</h2>
                {% for review in pendingReviews %}
                    {% include 'employee/_review_card.html.twig' with { review: review } %}
                {% else %}
                    {# Message si aucun avis n'est en attente. #}
                    <p class="employee-empty" data-review-group-empty>Aucun avis en attente.</p>
                {% endfor %}
            </section>

            {# Groupe des avis acceptes. #}
            <section class="employee-review-group" data-review-group="valide">
                <h2>Accept&eacute;s</h2>
                {% for review in acceptedReviews %}
                    {% include 'employee/_review_card.html.twig' with { review: review } %}
                {% else %}
                    {# Message si aucun avis accepte n'existe. #}
                    <p class="employee-empty" data-review-group-empty>Aucun avis accept&eacute;.</p>
                {% endfor %}
            </section>

            {# Groupe des avis refuses. #}
            <section class="employee-review-group" data-review-group="refuse">
                <h2>Refus&eacute;s</h2>
                {% for review in refusedReviews %}
                    {% include 'employee/_review_card.html.twig' with { review: review } %}
                {% else %}
                    {# Message si aucun avis refuse n'existe. #}
                    <p class="employee-empty" data-review-group-empty>Aucun avis refus&eacute;.</p>
                {% endfor %}
            </section>

            {# Message affiche si les filtres masquent tous les avis. #}
            <p class="employee-empty" data-review-empty hidden>Aucun avis ne correspond aux filtres.</p>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Script qui gere les filtres et les actions de changement de statut. #}
    <script src="{{ asset('assets/scripts/employee-reviews.js') }}" defer></script>
{% endblock %}

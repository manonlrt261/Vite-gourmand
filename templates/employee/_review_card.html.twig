{# Normalise les données nécessaires à l'affichage et aux filtres JavaScript de la carte. #}
{% set status = review.statut|default('en_attente') %}
{% set statusLabel = status == 'valide' ? 'Accept&eacute;' : (status == 'refuse' ? 'Refus&eacute;' : 'En attente') %}
{% set date = review.created_at|date('Y-m-d') %}
{% set menuId = review.menu_id|default('') %}
{% set fullName = (review.prenom|default('Client') ~ ' ' ~ review.nom|default(''))|trim %}

{# Carte réutilisable de modération d'un avis client dans l'espace employé. #}
<article
    class="employee-review-card"
    {# Ces données normalisées permettent de filtrer et d'actualiser la carte sans rechargement. #}
    data-review-card
    data-search="{{ (fullName ~ ' commande ' ~ review.commande_id ~ ' ' ~ review.nom_menu|default(''))|lower }}"
    data-note="{{ review.note }}"
    data-date="{{ date }}"
    data-menu-id="{{ menuId }}"
    data-status="{{ status }}"
>
    {# Colonne client : identité, commande, date, note et statut de modération. #}
    <div class="employee-review-card__client">
        <h3>{{ fullName }}</h3>
        <p>Commande n&deg;{{ review.commande_id }}</p>
        <p>{{ review.date_commande|default(review.created_at)|date('d/m/Y') }}</p>
        <p>Note {{ review.note }}/5</p>
        <span class="employee-review-status" data-review-status-label>{{ statusLabel|raw }}</span>
    </div>

    {# Contenu de l'avis : commentaire, date et menu concerné. #}
    <div class="employee-review-card__content">
        <p>{{ review.commentaire|default('Aucun commentaire laiss&eacute;.') }}</p>
        <small>
            Avis du {{ review.created_at|date('d/m/Y') }}
            {% if review.nom_menu|default('') %}
                &middot; {{ review.nom_menu }}
            {% endif %}
        </small>
    </div>

    {# Actions de modération disponibles selon le statut actuel de l'avis. #}
    <div class="employee-review-card__actions">
        {# Permet d'accepter l'avis s'il n'est pas déjà accepté. #}
        {% if status != 'valide' %}
            <form method="post" action="{{ path('employee_review_status', { id: review.avis_id }) }}" data-review-action>
                {# Le même périmètre CSRF protège toutes les actions réservées à l'espace employé. #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                <input type="hidden" name="action" value="accept">
                <button type="submit" class="buttonaccept">Valider l'avis</button>
            </form>
        {% endif %}

        {# Permet de refuser l'avis s'il n'est pas déjà refusé. #}
        {% if status != 'refuse' %}
            <form method="post" action="{{ path('employee_review_status', { id: review.avis_id }) }}" data-review-action>
                {# Le jeton CSRF sécurise le changement de statut vers « refusé ». #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                <input type="hidden" name="action" value="refuse">
                <button type="submit" class="buttonrefuse">Refuser l'avis</button>
            </form>
        {% endif %}

        {# Permet de remettre un avis accepté ou refusé dans la file d'attente. #}
        {% if status != 'en_attente' %}
            <form method="post" action="{{ path('employee_review_status', { id: review.avis_id }) }}" data-review-action>
                {# Le jeton CSRF sécurise le retour de l'avis dans la file d'attente. #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                <input type="hidden" name="action" value="pending">
                <button type="submit" class="buttonwhite">Remettre en attente</button>
            </form>
        {% endif %}

        {# La suppression définitive nécessite une confirmation dans une fenêtre dédiée. #}
        <form method="post" action="{{ path('employee_review_delete', { id: review.avis_id }) }}" data-review-delete>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
            <button type="submit" class="buttonrefuse">Supprimer l'avis</button>
        </form>
    </div>
</article>

{% extends 'base.html.twig' %}

{# Génère le contrôle d'activation commun aux différents types d'éléments culinaires. #}
{% macro status_form(item, type) %}
    {# État courant de l'élément. #}
    {% set isActive = item.actif|default(1) == 1 %}

    {# Formulaire de bascule actif/inactif utilisé dans les tableaux. #}
    <form method="post" action="{{ path('employee_item_toggle', { type: type, id: item.id }) }}" class="employee-card-status-form" data-toggle-active-form data-item-type="{{ type }}" data-item-id="{{ item.id }}">
        {# Le jeton CSRF sécurise le changement d'état de l'élément. #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
        <button
            type="submit"
            class="{{ isActive ? 'badgeactif' : 'badgeinactif' }}"
            data-status-button
            aria-label="{{ isActive ? 'D&eacute;sactiver' : 'Activer' }} {{ item.title }}"
        >
            {{ isActive ? 'Actif' : 'Inactif' }}
        </button>
    </form>
{% endmacro %}

{# Génère les actions communes de modification et de suppression. #}
{% macro actions(item, type) %}
    <div class="employee-table-actions">
        {# Lien vers le formulaire de modification. #}
        <a href="{{ path('employee_item_edit', { type: type, id: item.id }) }}" class="buttonedit" aria-label="Modifier {{ item.title }}">Modifier</a>

        {# Formulaire de suppression, intercepté par JavaScript pour afficher une confirmation. #}
        <form method="post" action="{{ path('employee_item_delete', { type: type, id: item.id }) }}" data-confirm-delete>
            {# Le jeton CSRF sécurise la suppression logique de l'élément. #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
            <button type="submit" class="buttondelete" aria-label="Supprimer {{ item.title }}">Supprimer</button>
        </form>
    </div>
{% endmacro %}

{# Import des macros du fichier courant. #}
{% import _self as ui %}

{# Titre affiché dans l'onglet du navigateur. #}
{% block title %}Liste des menus et plats - Vite & Gourmand{% endblock %}

{% block body %}
    {# Bandeau principal réutilisable avec le titre de la page. #}
    {% include 'components/_big_title.html.twig' with {
        title: 'Liste des menus et plats',
        image: asset('assets/bigtittle.png'),
        image_alt: 'Plat Vite et Gourmand'
    } %}

    {# Contenu principal de la liste complète des éléments culinaires. #}
    <main class="employee-management-page employee-list-page">
        {# Lien de retour vers la page de gestion résumée. #}
        <a href="{{ path('employee_menus') }}" class="cart-back-link">&larr; Retour aux menus et plats</a>

        {# Section complète des menus. #}
        <section class="employee-list-section" id="menus">
            <div class="employee-list-heading">
                <div>
                    <h2>Les menus</h2>
                    <p>Ajoutez, modifiez ou supprimez vos menus.</p>
                </div>

                <a href="{{ path('employee_menu_create') }}" class="buttonprimary employee-add-button">Ajouter un menu</a>
            </div>

            <div class="employee-table-wrap">
                {# Contrairement à la page d'aperçu, ce tableau ne limite pas le nombre de menus. #}
                <table class="employee-management-table">
                    <thead>
                        <tr>
                            <th>Nom du menu</th>
                            <th>Nb de pers. min</th>
                            <th>Prix</th>
                            <th>Cat&eacute;gorie</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {# Boucle sur chaque menu. #}
                        {% for menu in menus %}
                            {# Ligne d'un menu avec ses informations principales et actions. #}
                            <tr data-management-card data-item-type="menu" data-item-id="{{ menu.id }}">
                                <td>{{ menu.title }}</td>
                                <td>{{ menu.personnes_minimum }} personnes</td>
                                <td>{{ menu.prix_par_personne|number_format(2, ',', ' ') }} &euro; / personne</td>
                                <td><span class="employee-category-badge">{{ menu.theme }}</span></td>
                                <td>{{ ui.status_form(menu, 'menu') }}</td>
                                <td>{{ ui.actions(menu, 'menu') }}</td>
                            </tr>
                        {% else %}
                            {# Message affiché si aucun menu n'existe. #}
                            <tr>
                                <td colspan="6">Aucun menu &agrave; afficher.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        {# Section complète des entrées. #}
        <section class="employee-list-section" id="entrees">
            <div class="employee-list-heading">
                <div>
                    <h2>Les entr&eacute;es</h2>
                    <p>Ajoutez, modifiez ou supprimez vos entr&eacute;es ind&eacute;pendamment des menus.</p>
                </div>

                <a href="{{ path('employee_meal_create', { type: 'entree' }) }}" class="buttonprimary employee-add-button">Ajouter une entr&eacute;e</a>
            </div>

            {# Tableau réutilisable pour les entrées. #}
            {% include 'employee/_meal_table.html.twig' with { items: entrees, type: 'entree', empty: 'Aucune entr&eacute;e &agrave; afficher.' } %}
        </section>

        {# Section complète des plats. #}
        <section class="employee-list-section" id="plats">
            <div class="employee-list-heading">
                <div>
                    <h2>Les plats</h2>
                    <p>Ajoutez, modifiez ou supprimez vos plats ind&eacute;pendamment des menus.</p>
                </div>

                <a href="{{ path('employee_meal_create', { type: 'plat' }) }}" class="buttonprimary employee-add-button">Ajouter un plat</a>
            </div>

            {# Tableau réutilisable pour les plats. #}
            {% include 'employee/_meal_table.html.twig' with { items: plats, type: 'plat', empty: 'Aucun plat &agrave; afficher.' } %}
        </section>

        {# Section complète des desserts. #}
        <section class="employee-list-section" id="desserts">
            <div class="employee-list-heading">
                <div>
                    <h2>Les desserts</h2>
                    <p>Ajoutez, modifiez ou supprimez vos desserts ind&eacute;pendamment des menus.</p>
                </div>

                <a href="{{ path('employee_meal_create', { type: 'dessert' }) }}" class="buttonprimary employee-add-button">Ajouter un dessert</a>
            </div>

            {# Tableau réutilisable pour les desserts. #}
            {% include 'employee/_meal_table.html.twig' with { items: desserts, type: 'dessert', empty: 'Aucun dessert &agrave; afficher.' } %}
        </section>

        {# Encadré informatif sur l'impact des modifications. #}
        <aside class="employee-info-box">
            <span class="employee-info-box__icon" aria-hidden="true">i</span>
            <div>
                <h2>Informations importantes</h2>
                <p>Les modifications apport&eacute;es &agrave; un menu ne sont pas r&eacute;percut&eacute;es sur les commandes en cours. Ces ajouts seront pris en compte uniquement pour les nouvelles commandes.</p>
            </div>
        </aside>
    </main>

    {# Modale unique réutilisée pour confirmer la suppression de n'importe quel élément. #}
    <div class="employee-delete-modal" data-delete-modal hidden>
        {# Overlay permettant de fermer la modale. #}
        <div class="employee-delete-modal__overlay" data-delete-cancel></div>

        {# Boîte de dialogue de suppression. #}
        <section class="employee-delete-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
            <h2 id="delete-modal-title">Attention</h2>
            <p>Voulez-vous vraiment supprimer cet &eacute;l&eacute;ment ? Il ne sera plus visible sur le site.</p>

            <div class="employee-delete-modal__actions">
                <button type="button" class="buttonoffwhite" aria-label="Confirmer la suppression de l'&eacute;l&eacute;ment" data-delete-confirm>Supprimer</button>
                <button type="button" class="buttonprimary" aria-label="Annuler la suppression de l'&eacute;l&eacute;ment" data-delete-cancel>Annuler</button>
            </div>
        </section>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Gère les changements d'état et soumet la suppression après confirmation. #}
    <script src="{{ asset('assets/scripts/employee-management.js') }}" defer></script>
{% endblock %}

{# Tableau réutilisable pour administrer les entrées, plats ou desserts depuis l'espace employé. #}
<div class="employee-table-wrap">
    <table class="employee-management-table employee-management-table--meal">
        {# En-tête du tableau : informations principales et actions disponibles. #}
        <thead>
            <tr>
                <th>Nom</th>
                <th>Menu associ&eacute;</th>
                <th>Cat&eacute;gorie</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
                {# L'état est actif par défaut pour rester compatible avec les éléments sans valeur explicite. #}
                {% set isActive = item.actif|default(1) == 1 %}
                {# Signale à l'interface qu'un élément peut rester indisponible via son menu parent. #}
                {% set hasInactiveMenu = item.menu_id|default(null) and item.menu_actif|default(1) == 0 %}

                {# Les attributs data-* relient la ligne aux actions JavaScript de gestion. #}
                <tr data-management-card data-item-type="{{ type }}" data-item-id="{{ item.id }}" {% if item.menu_id|default(null) %}data-parent-menu-id="{{ item.menu_id }}"{% endif %}>
                    <td>{{ item.title }}</td>
                    <td>{{ item.nom_menu|default('Ind&eacute;pendant') ?: 'Ind&eacute;pendant' }}</td>
                    <td><span class="employee-category-badge">{{ item.theme }}</span></td>
                    <td>
                        {# Formulaire permettant d'activer ou désactiver l'élément. #}
                        <form method="post" action="{{ path('employee_item_toggle', { type: type, id: item.id }) }}" class="employee-card-status-form" data-toggle-active-form data-item-type="{{ type }}" data-item-id="{{ item.id }}" {% if item.menu_id|default(null) %}data-parent-menu-id="{{ item.menu_id }}"{% endif %}>
                            {# Le jeton CSRF sécurise le changement d'état soumis depuis le tableau. #}
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                            <button
                                type="submit"
                                class="{{ isActive ? 'badgeactif' : 'badgeinactif' }}"
                                data-status-button
                                title="{{ hasInactiveMenu ? 'Le menu associ&eacute; est inactif.' : '' }}"
                                aria-label="{{ isActive ? 'D&eacute;sactiver' : 'Activer' }} {{ item.title }}"
                            >
                                {{ isActive ? 'Actif' : 'Inactif' }}
                            </button>
                        </form>
                    </td>
                    <td>
                        {# Actions de modification ou suppression de l'élément. #}
                        <div class="employee-table-actions">
                            <a href="{{ path('employee_item_edit', { type: type, id: item.id }) }}" class="buttonedit" aria-label="Modifier {{ item.title }}">Modifier</a>

                            {# La confirmation JavaScript précède la soumission de la suppression. #}
                            <form method="post" action="{{ path('employee_item_delete', { type: type, id: item.id }) }}" data-confirm-delete>
                                {# Le jeton CSRF sécurise la demande de suppression. #}
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
                                <button type="submit" class="buttondelete" aria-label="Supprimer {{ item.title }}">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                {# Message affiché si aucun élément n'existe dans cette catégorie. #}
                <tr>
                    <td colspan="5">{{ empty }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% extends 'base.html.twig' %}

{# File de modération des avis clients en attente de décision. #}
{% block title %}Gestion des avis - Vite & Gourmand{% endblock %}

{% block body %}
    {# Bandeau principal réutilisable avec le titre de la page. #}
    {% include 'components/_big_title.html.twig' with {
        title: 'Gestion des avis',
        image: asset('assets/bigtittle.png'),
        image_alt: 'Plat Vite et Gourmand'
    } %}

    {# Contenu principal de la page de modération des avis en attente. #}
    <main class="employee-reviews-page">
        {# Lien de retour vers l'espace employé ou administrateur. #}
        {% include 'components/_workspace_back_link.html.twig' %}

        {# Introduction de la page. #}
        <section class="employee-reviews-intro">
            <h1>Avis en attente de validation</h1>
            <p>Consultez les avis laiss&eacute;s par vos clients et validez ceux que vous souhaitez publier sur le site.</p>
        </section>

        {# Filtres appliqués côté navigateur aux métadonnées de chaque carte d'avis. #}
        <section class="employee-review-filters" data-review-filters>
            {# Recherche par client ou numéro de commande. #}
            <label>
                <span class="sr-only">Rechercher un avis par client ou num&eacute;ro de commande</span>
                <input type="search" name="search" placeholder="Rechercher par client ou num&eacute;ro de commande" data-review-search>
            </label>

            <div class="employee-review-filter-row">
                {# Filtre par note. #}
                <label>
                    <span class="sr-only">Filtrer les avis par note</span>
                    <select name="note" data-review-note>
                        <option value="">Note</option>
                        {% for note in 1..5 %}
                            <option value="{{ note }}">{{ note }}/5</option>
                        {% endfor %}
                    </select>
                </label>

                {# Filtre par période. #}
                <label>
                    <span class="sr-only">Filtrer les avis par p&eacute;riode</span>
                    <select name="period" data-review-period>
                        <option value="">P&eacute;riode</option>
                        <option value="10days">10 derniers jours</option>
                        <option value="previous_month">Mois pr&eacute;c&eacute;dent</option>
                        <option value="6months">6 derniers mois</option>
                        <option value="2025">2025</option>
                        <option value="2024">2024</option>
                        <option value="other">Autres</option>
                    </select>
                </label>

                {# Filtre par menu concerné. #}
                <label>
                    <span class="sr-only">Filtrer les avis par menu</span>
                    <select name="menu" data-review-menu>
                        <option value="">Menu</option>
                        {% for menu in menus %}
                            <option value="{{ menu.menu_id }}">{{ menu.nom_menu }}</option>
                        {% endfor %}
                    </select>
                </label>
            </div>

            {# Boutons pour appliquer ou réinitialiser les filtres. #}
            <div class="employee-review-filter-actions">
                <button type="button" class="buttonprimary" data-review-apply>Appliquer les filtres</button>
                <button type="button" class="buttonoffwhite" data-review-reset>R&eacute;initialiser les filtres</button>
            </div>

            {# Le script remplace la valeur initiale par le nombre de cartes correspondant aux filtres. #}
            <p><span data-review-count>{{ pendingCount }}</span> avis en attente</p>
        </section>

        {# Lien vers la page qui regroupe tous les avis, quel que soit leur statut. #}
        <div class="employee-review-link-row">
            <a href="{{ path('employee_reviews_all') }}">Voir tous les avis</a>
        </div>

        {# Mise en page : liste d'avis à gauche, informations à droite. #}
        <div class="employee-reviews-layout">
            {# Liste des avis en attente de modération. #}
            <section class="employee-review-list-large" data-review-list>
                {% for review in reviews %}
                    {# Carte réutilisable d'un avis. #}
                    {% include 'employee/_review_card.html.twig' with { review: review } %}
                {% else %}
                    {# Message si aucun avis n'est en attente. #}
                    <p class="employee-empty">Aucun avis en attente.</p>
                {% endfor %}

                {# Message affiché quand les filtres ne retournent aucun avis. #}
                <p class="employee-empty" data-review-empty hidden>Aucun avis ne correspond aux filtres.</p>
            </section>

            {# Encadré explicatif sur la modération des avis. #}
            <aside class="employee-reviews-info">
                <h2>&Agrave; propos des avis</h2>
                <ul>
                    <li>Les avis sont collect&eacute;s apr&egrave;s une commande client.</li>
                    <li>Seuls les avis valid&eacute;s peuvent appara&icirc;tre publiquement.</li>
                    <li>Un avis refus&eacute; ne sera jamais affich&eacute;.</li>
                </ul>
            </aside>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Gère les filtres et les changements de statut sans rechargement complet. #}
    <script src="{{ asset('assets/scripts/employee-reviews.js') }}" defer></script>
{% endblock %}

{% extends 'base.html.twig' %}

{# Indique si le formulaire concerne un menu complet. #}
{% set isMenu = type == 'menu' %}
{# Determine le nom du champ a lire pour une entree, un plat ou un dessert. #}
{% set nameField = type == 'entree' ? 'nom_entree' : (type == 'plat' ? 'nom_plat' : 'nom_dessert') %}

{# Titre dynamique de la page selon l'action : ajout ou modification. #}
{% block title %}{{ pageTitle }} - Vite & Gourmand{% endblock %}

{% block body %}
    {# Bandeau principal reutilisable avec le titre fourni par le controleur. #}
    {% include 'components/_big_title.html.twig' with {
        title: pageTitle,
        image: asset('assets/bigtittle.png'),
        image_alt: 'Plat Vite et Gourmand'
    } %}

    {# Contenu principal du formulaire de gestion. #}
    <main class="employee-management-page employee-form-page">
        {# Lien de retour vers la liste complete des menus et plats. #}
        <a href="{{ path('employee_items_all') }}" class="cart-back-link">&larr; Retour aux menus et plats</a>

        {# Formulaire d'ajout ou modification d'un menu, entree, plat ou dessert. #}
        <form method="post" class="employee-edit-form">
            {# Token CSRF : protege la creation ou la modification d un menu, plat, entree ou dessert. #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('employee_action') }}">
            {# Champs specifiques aux menus complets. #}
            {% if isMenu %}
                {# Nom public du menu. #}
                <label>
                    <span>Nom du menu</span>
                    <input type="text" name="nom_menu" value="{{ item.nom_menu|default('') }}" required>
                </label>

                {# Theme du menu, limite aux valeurs autorisees. #}
                <label>
                    <span>Th&egrave;me</span>
                    <select name="theme" required data-menu-theme-source>
                        <option value="">Choisir un th&egrave;me</option>
                        <option value="Classique" {{ item.theme|default('') == 'Classique' ? 'selected' : '' }}>Classique</option>
                        <option value="&Eacute;v&eacute;nementiel" {{ item.theme|default('') in ['Événementiel', 'Evénementiel', 'Evenementiel'] ? 'selected' : '' }}>&Eacute;v&eacute;nementiel</option>
                        <option value="Saisonnier" {{ item.theme|default('') == 'Saisonnier' ? 'selected' : '' }}>Saisonnier</option>
                        <option value="R&eacute;gime particulier" {{ item.theme|default('') in ['Régime particulier', 'Regime particulier'] ? 'selected' : '' }}>R&eacute;gime particulier</option>
                    </select>
                </label>

                {# Description affichee sur la page menus et detail menu. #}
                <label class="employee-form-field--full">
                    <span>Description</span>
                    <textarea name="description" required>{{ item.description|default('') }}</textarea>
                </label>

                {# Conditions particulieres du menu. #}
                <label class="employee-form-field--full">
                    <span>Conditions</span>
                    <textarea name="conditions" required>{{ item.conditions|default('') }}</textarea>
                </label>

                {# Dates optionnelles de disponibilite du menu. #}
                <label>
                    <span>Date de d&eacute;but de disponibilit&eacute;</span>
                    <input type="date" name="date_debut_disponibilite" value="{{ item.date_debut_disponibilite|default('') }}">
                </label>

                {# Nombre minimum de personnes pour commander ce menu. #}
                <label>
                    <span>Date de fin de disponibilit&eacute;</span>
                    <input type="date" name="date_fin_disponibilite" value="{{ item.date_fin_disponibilite|default('') }}">
                </label>

                {# Prix par personne utilise dans le panier et les commandes. #}
                <label>
                    <span>Nombre de personnes minimum</span>
                    <input type="number" name="personnes_minimum" min="1" value="{{ item.personnes_minimum|default(1) }}" required>
                </label>

                {# Stock disponible du menu. #}
                <label>
                    <span>Prix par personne</span>
                    <input type="number" name="prix_par_personne" min="0" step="0.01" value="{{ item.prix_par_personne|default(0) }}" required>
                </label>

                <label>
                    <span>Stock disponible</span>
                    <input type="number" name="stock_disponible" min="0" value="{{ item.stock_disponible|default(0) }}" required>
                </label>

                {# Case enregistree en base : 1 si le menu propose un pret de materiel, 0 sinon. #}
                <label class="employee-form-checkbox">
                    <input type="checkbox" name="materiel_disponible" value="1" {{ item.materiel_disponible|default(0) == 1 ? 'checked' : '' }}>
                    <span>Pr&ecirc;t de mat&eacute;riel</span>
                </label>
            {% else %}
                {# Champs specifiques aux entrees, plats et desserts. #}
                <label>
                    <span>Nom</span>
                    <input type="text" name="nom" value="{{ attribute(item, nameField)|default('') }}" required>
                </label>

                {# Menu auquel rattacher l'element, ou independant si aucun menu n'est choisi. #}
                <label>
                    <span>Menu associ&eacute;</span>
                    <select name="menu_id">
                        <option value="">Ind&eacute;pendant</option>
                        {# Liste des menus disponibles pour l'association. #}
                        {% for menu in menus %}
                            <option value="{{ menu.menu_id }}" {{ item.menu_id|default(null) == menu.menu_id ? 'selected' : '' }}>
                                {{ menu.nom_menu }}
                            </option>
                        {% endfor %}
                    </select>
                </label>

                {# Theme de l'element. #}
                <label>
                    <span>Th&egrave;me</span>
                    <select name="theme" required>
                        <option value="">Choisir un th&egrave;me</option>
                        <option value="Classique" {{ item.theme|default('') == 'Classique' ? 'selected' : '' }}>Classique</option>
                        <option value="&Eacute;v&eacute;nementiel" {{ item.theme|default('') in ['Événementiel', 'Evénementiel', 'Evenementiel'] ? 'selected' : '' }}>&Eacute;v&eacute;nementiel</option>
                        <option value="Saisonnier" {{ item.theme|default('') == 'Saisonnier' ? 'selected' : '' }}>Saisonnier</option>
                        <option value="R&eacute;gime particulier" {{ item.theme|default('') in ['Régime particulier', 'Regime particulier'] ? 'selected' : '' }}>R&eacute;gime particulier</option>
                    </select>
                </label>

                {# Allergènes affiches au client. #}
                <label>
                    <span>Allerg&egrave;nes</span>
                    <input type="text" name="allergenes" value="{{ item.allergenes|default('') }}" required>
                </label>

                {# Description de l'entree, du plat ou du dessert. #}
                <label class="employee-form-field--full">
                    <span>Description</span>
                    <textarea name="description" required>{{ item.description|default('') }}</textarea>
                </label>
            {% endif %}

            {# Chemin de l'image affichee sur le site. Ce champ reste facultatif en creation. #}
            <label>
                <span>Chemin de l'image</span>
                <input type="text" name="image_url" value="{{ item.image_url|default('') }}">
            </label>

            {# Texte alternatif de l'image pour l'accessibilite. Ce champ reste facultatif en creation. #}
            <label>
                <span>Texte alternatif de l'image</span>
                <input type="text" name="image_alt" value="{{ item.image_alt|default('') }}">
            </label>

            {# Case qui determine si l'element est visible sur le site public. #}
            <label class="employee-form-checkbox">
                <input type="checkbox" name="actif" value="1" {{ item.actif|default(1) == 1 ? 'checked' : '' }}>
                <span>Visible sur le site</span>
            </label>

            {% if isMenu and isCreate %}
                {# Zone optionnelle : elle permet de preparer directement l'entree, le plat et le dessert du menu en cours de creation. #}
                <div class="employee-linked-meals employee-form-field--full" data-linked-meals>
                    <p class="employee-linked-meals__title">Ajouter les elements du menu</p>
                    <div class="employee-linked-meals__actions">
                        <button type="button" class="buttonoffwhite" data-linked-meal-open="entree">+ Entr&eacute;e</button>
                        <button type="button" class="buttonoffwhite" data-linked-meal-open="plat">+ Plat</button>
                        <button type="button" class="buttonoffwhite" data-linked-meal-open="dessert">+ Dessert</button>
                    </div>
                </div>

                {% set linkedMealLabels = {
                    entree: 'Ajouter une entr&eacute;e',
                    plat: 'Ajouter un plat',
                    dessert: 'Ajouter un dessert'
                } %}

                {% for linkedType, linkedTitle in linkedMealLabels %}
                    {# Fenetre modale ouverte depuis les boutons + Entree, + Plat et + Dessert. #}
                    <div class="employee-linked-meal-modal" data-linked-meal-modal="{{ linkedType }}" hidden>
                        <div class="employee-linked-meal-modal__overlay" data-linked-meal-close></div>
                        <section class="employee-linked-meal-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="linked-meal-title-{{ linkedType }}">
                            <header class="employee-linked-meal-modal__header">
                                <h2 id="linked-meal-title-{{ linkedType }}">{{ linkedTitle|raw }}</h2>
                                <button type="button" aria-label="Fermer la fen&ecirc;tre" data-linked-meal-close>&times;</button>
                            </header>

                            {# Ces champs seront enregistres avec le menu apres recuperation de son nouvel identifiant. #}
                            <div class="employee-linked-meal-modal__grid">
                                <label>
                                    <span>Nom</span>
                                    <input type="text" name="linked_items[{{ linkedType }}][nom]" placeholder="Nom">
                                </label>

                                <label>
                                    <span>Th&egrave;me</span>
                                    <select name="linked_items[{{ linkedType }}][theme]" data-linked-meal-theme>
                                        <option value="">Choisir un th&egrave;me</option>
                                        <option value="Classique">Classique</option>
                                        <option value="&Eacute;v&eacute;nementiel">&Eacute;v&eacute;nementiel</option>
                                        <option value="Saisonnier">Saisonnier</option>
                                        <option value="R&eacute;gime particulier">R&eacute;gime particulier</option>
                                    </select>
                                </label>

                                <label>
                                    <span>Allerg&egrave;nes</span>
                                    <input type="text" name="linked_items[{{ linkedType }}][allergenes]" placeholder="Allerg&egrave;nes">
                                </label>

                                <label class="employee-linked-meal-modal__full">
                                    <span>Description</span>
                                    <textarea name="linked_items[{{ linkedType }}][description]" placeholder="Description"></textarea>
                                </label>

                                <label>
                                    <span>Chemin de l'image</span>
                                    <input type="text" name="linked_items[{{ linkedType }}][image_url]">
                                </label>

                                <label>
                                    <span>Texte alternatif de l'image</span>
                                    <input type="text" name="linked_items[{{ linkedType }}][image_alt]">
                                </label>

                                <label class="employee-form-checkbox employee-linked-meal-modal__full">
                                    <input type="checkbox" name="linked_items[{{ linkedType }}][actif]" value="1" checked>
                                    <span>Visible sur le site</span>
                                </label>
                            </div>

                            <div class="employee-linked-meal-modal__actions">
                                <button type="button" class="buttonprimary" data-linked-meal-close>Valider</button>
                            </div>
                        </section>
                    </div>
                {% endfor %}
            {% endif %}

            {# Actions finales : enregistrer ou annuler. #}
            <div class="employee-form-actions">
                <button type="submit" class="buttonprimary">{{ isCreate ? 'Ajouter' : 'Enregistrer' }}</button>
                <a href="{{ path('employee_items_all') }}" class="buttonoffwhite">Annuler</a>
            </div>
        </form>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if isMenu and isCreate %}
        {# Script qui ouvre et ferme les fenetres + Entree, + Plat et + Dessert. #}
        <script src="{{ asset('assets/scripts/employee-menu-form.js') }}" defer></script>
    {% endif %}
{% endblock %}

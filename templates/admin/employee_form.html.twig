{% extends 'base.html.twig' %}

{# Création d'un compte employé et collecte de ses informations administratives. #}
{% block title %}Ajouter un employé - Vite & Gourmand{% endblock %}

{% block body %}
    {% include 'components/_big_title.html.twig' with {
        title: 'Ajouter un employé',
        image: asset('assets/bigtittle.png'),
        image_alt: 'Ajouter un employé Vite et Gourmand'
    } %}

    <main class="admin-employee-form-page">
        <a href="{{ path('admin_employees') }}" class="cart-back-link">&larr; Retour à la gestion des employés</a>

        <section class="admin-employees-heading">
            <div>
                <h1>Ajouter un employé</h1>
                <p>Créez un compte employé avec les informations utiles à l'administration interne.</p>
            </div>
        </section>

        {# Les erreurs de validation serveur sont regroupées avant le formulaire. #}
        {% if errors is not empty %}
            <div class="contact-alert">
                {% for error in errors %}
                    <p>{{ error }}</p>
                {% endfor %}
            </div>
        {% endif %}

        {# Le contrôleur réinjecte les valeurs saisies dans employee lorsque la validation échoue. #}
        <form method="post" class="admin-employee-create-form">
            {# Jeton commun aux opérations administratives sur les comptes employés. #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('admin_employee_action') }}">

            {# Identité de l'employé. #}
            <label>
                <span>Nom *</span>
                <input type="text" name="nom" value="{{ employee.nom|default('') }}" placeholder="Votre nom" required>
            </label>

            <label>
                <span>Prénom *</span>
                <input type="text" name="prenom" value="{{ employee.prenom|default('') }}" placeholder="Votre prénom" required>
            </label>

            {# Informations de naissance demandées pour compléter la fiche administrative. #}
            <label>
                <span>Date de naissance *</span>
                <input type="date" name="date_naissance" value="{{ employee.date_naissance|default('') }}" required>
            </label>

            <label>
                <span>Lieu de naissance *</span>
                <input type="text" name="lieu_naissance" value="{{ employee.lieu_naissance|default('') }}" placeholder="Votre lieu de naissance" required>
            </label>

            {# Adresse postale complète de l'employé. #}
            <label class="admin-employee-create-form__full">
                <span>Adresse postale *</span>
                <input type="text" name="adresse_postale" value="{{ employee.adresse_postale|default('') }}" placeholder="Votre adresse postale" required>
            </label>

            <label>
                <span>Code postal *</span>
                <input type="text" name="code_postal" value="{{ employee.code_postal|default('') }}" placeholder="Votre code postal" required>
            </label>

            <label>
                <span>Ville *</span>
                <input type="text" name="ville" value="{{ employee.ville|default('') }}" placeholder="Votre ville" required>
            </label>

            {# L'adresse professionnelle sert d'identifiant de connexion. #}
            <label>
                <span>Email professionnel *</span>
                <input type="email" name="email" value="{{ employee.email|default('') }}" placeholder="votre.email@vite-gourmand.fr" required>
            </label>

            {# L'adresse personnelle reçoit la notification de création du compte. #}
            <label>
                <span>Email personnel *</span>
                <input type="email" name="email_personnel" value="{{ employee.email_personnel|default('') }}" placeholder="votre.email@exemple.fr" required>
            </label>

            <label class="admin-employee-create-form__full">
                <span>Numéro de téléphone *</span>
                <input type="text" name="telephone" value="{{ employee.telephone|default('') }}" placeholder="Votre numéro de téléphone" required>
            </label>

            {# Poste de l'employé : la liste vient du contrôleur pour garder les postes cohérents partout. #}
            <label class="admin-employee-create-form__full">
                <span>Poste *</span>
                <select name="poste" required>
                    <option value="">Choisir un poste</option>
                    {# Restaure le poste sélectionné après une erreur de validation. #}
                    {% for job in jobs %}
                        <option value="{{ job }}" {{ (employee.poste|default('')) == job ? 'selected' }}>{{ job }}</option>
                    {% endfor %}
                </select>
            </label>

            {# Les attributs data-password-* relient les deux champs au contrôle d'affichage du mot de passe. #}
            <label>
                <span>Création de mot de passe *</span>
                <span class="auth-password-control">
                    <input type="password" name="password" value="{{ employee.password|default('') }}" placeholder="Créer un mot de passe" data-password-input required>
                    <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Afficher le mot de passe" title="Afficher le mot de passe">
                        <span aria-hidden="true">Afficher</span>
                    </button>
                </span>
            </label>

            <label>
                <span>Confirmation du mot de passe *</span>
                <span class="auth-password-control">
                    <input type="password" name="password_confirm" value="{{ employee.password_confirm|default('') }}" placeholder="Confirmer le mot de passe" data-password-input required>
                    <button type="button" class="auth-password-toggle" data-password-toggle aria-label="Afficher la confirmation du mot de passe" title="Afficher la confirmation du mot de passe">
                        <span aria-hidden="true">Afficher</span>
                    </button>
                </span>
            </label>

            {# Rappel des règles de sécurité appliquées côté serveur avant l'enregistrement. #}
            <div class="register-password-info admin-employee-password-info admin-employee-create-form__full">
                <p><strong>Le mot de passe doit contenir au minimum :</strong></p>
                <ul>
                    <li>10 caractères minimum</li>
                    <li>Au minimum 1 caractère spécial</li>
                    <li>Une majuscule</li>
                    <li>Une minuscule</li>
                    <li>Au minimum 1 chiffre</li>
                </ul>
            </div>

            <div class="admin-employee-create-form__actions">
                <button type="submit" class="buttonprimary">Créer l'employé</button>
                <a href="{{ path('admin_employees') }}" class="buttonoffwhite">Annuler</a>
            </div>
        </form>
    </main>
{% endblock %}

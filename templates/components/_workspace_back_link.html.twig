{% set isAdminWorkspace = workspaceRole == 'administrateur' or workspaceRoleId == 3 %}

<a href="{{ path(isAdminWorkspace ? 'admin_dashboard' : 'employee_dashboard') }}" class="cart-back-link">
    &larr; Retour &agrave; mon espace {{ isAdminWorkspace ? 'administrateur' : 'employ&eacute;' }}
</a>

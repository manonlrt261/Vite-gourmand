{# Bandeau de titre réutilisable : `title` est requis, `image` et `image_alt` sont facultatifs. #}
<section class="bigtittle">
    {# Le visuel générique garantit un rendu complet lorsqu’aucune image propre à la page n’est fournie. #}
    <img
        src="{{ image|default(asset('assets/bigtittle.png')) }}"
        alt="{{ image_alt|default('Visuel Vite et Gourmand') }}"
        class="bigtittle-image"
    >

    {# Ce voile purement décoratif maintient le contraste du titre sur l’image. #}
    <div class="bigtittle-overlay" aria-hidden="true"></div>

    <h1 class="bigtittle-title">{{ title }}</h1>
</section>

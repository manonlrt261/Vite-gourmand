{% extends 'base.html.twig' %}

{# Titre affiche dans l'onglet du navigateur pour la page mot de passe oublie. #}
{% block title %}Mot de passe oublié - Vite & Gourmand{% endblock %}

{% block body %}
{# Bandeau principal reutilisable avec le titre de la page et l'image de fond. #}
{% include 'components/_big_title.html.twig' with {
    title: 'Mot de passe oublié',
    image: asset('assets/bigtittle.png'),
    image_alt: 'Table gourmande Vite et Gourmand'
} %}

{# Contenu principal de la demande de reinitialisation. #}
<main class="forgot-page">
    {# Carte centrale contenant les explications, les messages et le formulaire. #}
    <section class="forgot-card">
        {# En-tete qui explique l'action attendue de l'utilisateur. #}
        <div class="forgot-card__header">
            <h1>Saisissez votre adresse mail</h1>
            <p>Nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>
            <span aria-hidden="true"></span>
        </div>

        {# Message d'erreur si l'email est absent ou si le lien ne peut pas etre genere. #}
        {% for message in app.flashes('forgot_error') %}
            <div class="auth-alert auth-alert--error">{{ message }}</div>
        {% endfor %}

        {# Message de succes apres la demande de reinitialisation. #}
        {% for message in app.flashes('forgot_success') %}
            <div class="auth-alert auth-alert--success">{{ message }}</div>
        {% endfor %}

        {# Lien local de reinitialisation affiche pour les tests sans vrai SMTP. #}
        {% for link in app.flashes('reset_link') %}
            <div class="auth-alert auth-alert--success forgot-reset-link">
                <p>Lien de réinitialisation local :</p>
                <a href="{{ link }}">Créer un nouveau mot de passe</a>
                {# Champ de secours pour copier le lien si le navigateur bloque le clic. #}
                <label class="forgot-reset-link__copy">
                    <span>Si le clic est bloqué, copiez cette adresse :</span>
                    <input type="text" value="{{ link }}" readonly data-reset-link-input>
                </label>
                {# Bouton gere par JavaScript pour copier le lien dans le presse-papiers. #}
                <button type="button" class="buttonoffwhite forgot-reset-link__button" data-reset-link-copy>Copier le lien</button>
            </div>
        {% endfor %}

        {# Formulaire de demande de lien de reinitialisation. #}
        <form class="forgot-form" method="post">
            {# Email du compte pour lequel l'utilisateur souhaite changer le mot de passe. #}
            <label class="forgot-field">
                <span>Email</span>
                <input type="email" name="email" placeholder="votre.email@exemple.fr" autocomplete="email" required>
            </label>

            {# Bouton qui envoie la demande au serveur. #}
            <button type="submit" class="buttonprimary forgot-submit">Envoyer le lien de réinitialisation</button>
        </form>

        {# Separateur visuel entre le formulaire et les liens de navigation. #}
        <div class="forgot-separator">
            <span></span>
            <p>ou</p>
            <span></span>
        </div>

        {# Navigation rapide vers connexion ou inscription. #}
        <nav class="forgot-navigation" aria-label="Navigation compte">
            <div>
                <span>Déjà inscrit ?</span>
                <a href="{{ path('login') }}">Connectez-vous !</a>
            </div>

            <span class="forgot-navigation__divider" aria-hidden="true"></span>

            <div>
                <span>Pas encore inscrit ?</span>
                <a href="{{ path('register') }}">Créer un compte !</a>
            </div>
        </nav>
    </section>
</main>

{# Script local pour copier le lien de reinitialisation affiche sur la page. #}
<script>
    (() => {
        {# Recuperation du bouton de copie et du champ contenant le lien. #}
        const copyButton = document.querySelector('[data-reset-link-copy]');
        const linkInput = document.querySelector('[data-reset-link-input]');

        {# Si aucun lien n'est affiche, le script s'arrete sans erreur. #}
        if (!copyButton || !linkInput) {
            return;
        }

        {# Au clic, le lien est selectionne puis copie dans le presse-papiers si possible. #}
        copyButton.addEventListener('click', async () => {
            linkInput.select();
            linkInput.setSelectionRange(0, linkInput.value.length);

            try {
                await navigator.clipboard.writeText(linkInput.value);
                copyButton.textContent = 'Lien copié';
            } catch (error) {
                {# Message de secours si la copie automatique est bloquee par le navigateur. #}
                copyButton.textContent = 'Lien sélectionné';
            }
        });
    })();
</script>
{% endblock %}

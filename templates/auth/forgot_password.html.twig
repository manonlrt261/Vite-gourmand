{% extends 'base.html.twig' %}

{# Titre affiché dans l'onglet du navigateur pour la page mot de passe oublié. #}
{% block title %}Mot de passe oublié - Vite & Gourmand{% endblock %}

{% block body %}
{# Bandeau principal réutilisable avec le titre de la page et l'image de fond. #}
{% include 'components/_big_title.html.twig' with {
    title: 'Mot de passe oublié',
    image: asset('assets/bigtittle.png'),
    image_alt: 'Table gourmande Vite et Gourmand'
} %}

{# Contenu principal de la demande de réinitialisation. #}
<main class="forgot-page">
    {# Lien de retour vers la page d'accueil du site. #}
    <a href="{{ path('home_show') }}" class="cart-back-link forgot-back-link">&larr; Retour &agrave; l'accueil</a>

    {# Carte centrale contenant les explications, les messages et le formulaire. #}
    <section class="forgot-card">
        {# En-tête qui explique l'action attendue de l'utilisateur. #}
        <div class="forgot-card__header">
            <h1>Saisissez votre adresse mail</h1>
            <p>Nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>
            <span aria-hidden="true"></span>
        </div>

        {# Message d'erreur si l'email est absent ou invalide. #}
        {% for message in app.flashes('forgot_error') %}
            <div class="auth-alert auth-alert--error">{{ message }}</div>
        {% endfor %}

        {# Message de succès après la demande de réinitialisation. #}
        {% for message in app.flashes('forgot_success') %}
            <div class="auth-alert auth-alert--success">{{ message }}</div>
        {% endfor %}

        {# Formulaire de demande de lien de réinitialisation. #}
        <form class="forgot-form" method="post">
            {# Token CSRF : protege la demande d email de reinitialisation. #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('auth_action') }}">

            {# Email du compte pour lequel l'utilisateur souhaite changer le mot de passe. #}
            <label class="forgot-field">
                <span>Email</span>
                <input type="email" name="email" placeholder="votre.email@exemple.fr" autocomplete="email" required>
            </label>

            {# Bouton qui envoie la demande au serveur. #}
            <button type="submit" class="buttonprimary forgot-submit">Envoyer le lien de réinitialisation</button>
        </form>

        {# Séparateur visuel entre le formulaire et les liens de navigation. #}
        <div class="forgot-separator">
            <span></span>
            <p>ou</p>
            <span></span>
        </div>

        {# Navigation rapide vers connexion ou inscription. #}
        <nav class="forgot-navigation" aria-label="Navigation compte">
            <div>
                <span>Déjà inscrit ?</span>
                <a href="{{ path('login') }}">Connectez-vous !</a>
            </div>

            <span class="forgot-navigation__divider" aria-hidden="true"></span>

            <div>
                <span>Pas encore inscrit ?</span>
                <a href="{{ path('register') }}">Créer un compte !</a>
            </div>
        </nav>
    </section>
</main>
{% endblock %}

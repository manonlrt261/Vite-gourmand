{% extends 'base.html.twig' %}

{# Titre affiche dans l'onglet du navigateur pour la page de nouveau mot de passe. #}
{% block title %}Création d'un nouveau mot de passe - Vite & Gourmand{% endblock %}

{% block body %}
{# Bandeau principal reutilisable avec le titre de la page et l'image de fond. #}
{% include 'components/_big_title.html.twig' with {
    title: 'Création d\'un nouveau mot de passe',
    image: asset('assets/bigtittle.png'),
    image_alt: 'Table gourmande Vite et Gourmand'
} %}

{# Contenu principal de la page de reinitialisation du mot de passe. #}
<main class="forgot-page">
    {# Carte centrale dediee au choix du nouveau mot de passe. #}
    <section class="forgot-card forgot-card--reset">
        {# En-tete qui explique a l'utilisateur qu'il doit saisir un nouveau mot de passe. #}
        <div class="forgot-card__header">
            <h1>Nouveau mot de passe</h1>
            <p>Choisissez un nouveau mot de passe pour accéder à votre compte.</p>
            <span aria-hidden="true"></span>
        </div>

        {# Messages d'erreur affiches si le lien est invalide ou si le mot de passe ne respecte pas les regles. #}
        {% for message in app.flashes('reset_error') %}
            <div class="auth-alert auth-alert--error">{{ message }}</div>
        {% endfor %}

        {# Formulaire d'enregistrement du nouveau mot de passe. #}
        <form class="forgot-form" method="post">
            {# Premier champ : nouveau mot de passe, avec bouton afficher/masquer. #}
            <label class="forgot-field">
                <span>Nouveau mot de passe</span>
                <span class="auth-password-control">
                    <input type="password" name="password" placeholder="Votre nouveau mot de passe" autocomplete="new-password" data-password-input required>
                    <button type="button" class="auth-password-toggle" data-password-toggle>Afficher</button>
                </span>
            </label>

            {# Rappel des regles de securite identiques a celles de l'inscription. #}
            <div class="register-password-info reset-password-info">
                <p>Le mot de passe doit contenir au minimum :</p>
                <ul>
                    <li>10 caractères minimum</li>
                    <li>Au minimum 1 caractère spécial</li>
                    <li>Une majuscule</li>
                    <li>Une minuscule</li>
                    <li>Au minimum 1 chiffre</li>
                </ul>
            </div>

            {# Deuxieme champ : confirmation du nouveau mot de passe. #}
            <label class="forgot-field">
                <span>Confirmer le mot de passe</span>
                <span class="auth-password-control">
                    <input type="password" name="password_confirm" placeholder="Confirmez votre mot de passe" autocomplete="new-password" data-password-input required>
                    <button type="button" class="auth-password-toggle" data-password-toggle>Afficher</button>
                </span>
            </label>

            {# Bouton qui valide le changement de mot de passe. #}
            <button type="submit" class="buttonprimary forgot-submit">Créer mon nouveau mot de passe</button>
        </form>
    </section>
</main>
{% endblock %}

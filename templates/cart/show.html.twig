{% extends 'base.html.twig' %}

{# Vue du panier renseigné : coordonnées, livraison, articles et validation. #}
{% block title %}Panier - Vite & Gourmand{% endblock %}

{% block javascripts %}
    {# Synchronise les quantités et le récapitulatif sans rechargement complet de la page. #}
    <script src="{{ asset('assets/scripts/cart.js') }}?v=20260719-1" defer></script>
{% endblock %}

{% block body %}
{# Bandeau commun aux pages du panier. #}
{% include 'components/_big_title.html.twig' with {
    title: 'Panier',
    image: asset('assets/bigtittle.png'),
    image_alt: 'Table gourmande Vite et Gourmand'
} %}

{# Contenu principal du panier. #}
<main class="cart-page">
    {# Lien permettant au client de revenir à la page des menus. #}
    <a href="{{ path('menu_index') }}" class="cart-back-link">&larr; Retour aux menus</a>

    {# La commande reste consultable hors connexion, mais ses champs et sa validation sont désactivés. #}
    {% if not isConnected %}
        <section class="cart-login-notice">
            <p>Vous devez vous connecter ou cr&eacute;er un compte pour valider votre panier.</p>
            <div>
                {# La cible ramène le client au panier après l’authentification ou l’inscription. #}
                <a href="{{ path('login', { target: app.request.pathInfo }) }}" class="buttonprimary">Connexion</a>
                <a href="{{ path('register', { target: app.request.pathInfo }) }}" class="buttonwhite">Inscription</a>
            </div>
        </section>
    {% endif %}

    {# Messages d’erreur liés au panier ou à la validation de la commande. #}
    {% for message in app.flashes('cart_error') %}
        <section class="cart-login-notice cart-login-notice--error">
            <p>{{ message }}</p>
        </section>
    {% endfor %}

    {# Formulaire principal du panier : il sert à mettre à jour les quantités et à commander. #}
    <form
        class="cart-layout"
        method="post"
        action="{{ path('cart_update') }}"
        data-cart-form
        data-exceptional-closures="{{ exceptionalClosures|default([])|json_encode|e('html_attr') }}"
    >
        {# Un même jeton CSRF protège la mise à jour du panier et sa validation. #}
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('cart_action') }}">

        {# Colonne gauche : informations client et adresse de livraison. #}
        <div class="cart-left-column">
            {# Bloc des informations personnelles du client. #}
            <section class="cart-card">
                <h2>Vos informations</h2>
                <div class="cart-card__line"></div>

                {# Les coordonnées connues sont préremplies pour le client connecté. #}
                <div class="cart-fields cart-fields--two">
                    <label class="cart-field">
                        <span>Nom *</span>
                        <input type="text" name="nom" placeholder="Votre nom" value="{{ customer.nom|default('') }}" required {{ not isConnected ? 'disabled' }}>
                    </label>

                    <label class="cart-field">
                        <span>Pr&eacute;nom *</span>
                        <input type="text" name="prenom" placeholder="Votre pr&eacute;nom" value="{{ customer.prenom|default('') }}" required {{ not isConnected ? 'disabled' }}>
                    </label>
                </div>

                {# Coordonnées de contact du client. #}
                <div class="cart-fields">
                    <label class="cart-field">
                        <span>Email *</span>
                        <input type="email" name="email" placeholder="votre.mail@exemple.fr" value="{{ customer.email|default('') }}" required {{ not isConnected ? 'disabled' }}>
                    </label>

                    <label class="cart-field">
                        <span>Num&eacute;ro de t&eacute;l&eacute;phone *</span>
                        <input type="tel" name="telephone" placeholder="Votre num&eacute;ro" value="{{ customer.telephone|default('') }}" required {{ not isConnected ? 'disabled' }}>
                    </label>
                </div>
            </section>

                {# Bloc de l’adresse et des informations de livraison. #}
            <section class="cart-card">
                <h2>Adresse de livraison</h2>
                <div class="cart-card__line"></div>

                {# Adresse postale de livraison. #}
                <div class="cart-fields">
                    <label class="cart-field">
                        <span>Adresse postale *</span>
                        <input type="text" name="adresse_livraison" placeholder="Votre adresse" value="{{ customer.adresse_postale|default('') }}" required {{ not isConnected ? 'disabled' }}>
                    </label>
                </div>

                {# Code postal et ville de livraison. #}
                <div class="cart-fields cart-fields--two">
                    <label class="cart-field">
                        <span>Code postal *</span>
                        <input type="text" name="code_postal_livraison" placeholder="Code postal" value="{{ customer.code_postal|default('') }}" required {{ not isConnected ? 'disabled' }}>
                    </label>

                    <label class="cart-field">
                        <span>Ville *</span>
                        <input type="text" name="ville_livraison" placeholder="Ville" value="{{ customer.ville|default('') }}" required {{ not isConnected ? 'disabled' }}>
                    </label>
                </div>

                {# Date de prestation et heure souhaitée pour la livraison. #}
                <div class="cart-fields cart-fields--two">
                    <label class="cart-field">
                        <span>Date de livraison</span>
                        <input type="date" name="date_prestation" required {{ not isConnected ? 'disabled' }} data-delivery-date>
                    </label>

                    <label class="cart-field">
                        <span>Heure souhait&eacute;e</span>
                        <input type="time" name="heure_livraison" min="08:00" max="22:00" required {{ not isConnected ? 'disabled' }}>
                    </label>
                </div>

                <p class="cart-closure-error" data-cart-closure-error role="alert" hidden></p>

                {# Règle tarifaire informative ; le montant effectif est calculé côté serveur. #}
                <div class="cart-delivery-info">
                    <span>i</span>
                    <p>
                        La livraison est offerte sur Bordeaux.<br>
                        En dehors de Bordeaux : 5,00 &euro; + 0,59 &euro; par kilom&egrave;tre.
                    </p>
                </div>
            </section>
        </div>

            {# Colonne droite : contenu du panier et récapitulatif financier. #}
        <aside class="cart-right-column">
            {# Liste des menus ajoutés au panier. #}
            <section class="cart-card cart-order-card">
                <h2>Votre commande</h2>
                <div class="cart-card__line"></div>

                <div class="cart-order-list">
                    {# Boucle sur chaque menu présent dans le panier. #}
                    {% for item in cartItems %}
                        {# Alias local du menu associé à la ligne de panier. #}
                        {% set menu = item.menu %}
                        {# L’identifiant exposé au script permet de synchroniser cette ligne avec son récapitulatif. #}
                        <article class="cart-order-card__content" data-cart-item="{{ menu.menu_id }}">
                            {# Image du menu si elle existe en base. #}
                            {% if menu.image_url %}
                                <img src="{{ asset(menu.image_url) }}" alt="{{ menu.image_alt ?: menu.nom_menu }}">
                            {% endif %}

                            {# Détails du menu : nom, prix par personne et nombre de personnes. #}
                            <div class="cart-order-card__details">
                                <h3>{{ menu.nom_menu }}</h3>
                                <small>{{ menu.prix_par_personne|number_format(2, ',', ' ') }} &euro; / pers</small>
                                {# Le minimum métier propre au menu est aussi transmis au contrôle natif du navigateur. #}
                                <label class="cart-quantity-field">
                                    <span>Nombre de personnes</span>
                                    <input
                                        type="number"
                                        name="quantities[{{ menu.menu_id }}]"
                                        value="{{ item.nombrePersonnes }}"
                                        min="{{ item.nombrePersonnesMinimum }}"
                                        step="1"
                                        data-cart-quantity
                                        data-menu-id="{{ menu.menu_id }}"
                                    >
                                </label>
                                {# Rappel du minimum de personnes pour ce menu. #}
                                <p data-cart-order-quantity="{{ menu.menu_id }}">Minimum {{ item.nombrePersonnesMinimum }} personnes</p>
                            </div>

                            {# La mise à jour soumet le formulaire principal ; la suppression cible un formulaire dédié plus bas. #}
                            <div class="cart-item-actions">
                                <button
                                    type="submit"
                                    class="cart-update-button"
                                    data-cart-update-button
                                    formnovalidate
                                    aria-label="Mettre &agrave; jour le nombre de personnes pour {{ menu.nom_menu }}"
                                >
                                    Mettre &agrave; jour
                                </button>

                                <button
                                    type="submit"
                                    form="cart-remove-{{ menu.menu_id }}"
                                    class="cart-remove-button"
                                    data-cart-remove-button
                                    data-menu-id="{{ menu.menu_id }}"
                                    aria-label="Supprimer {{ menu.nom_menu }} du panier"
                                >
                                    Supprimer
                                </button>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            </section>

            {# Récapitulatif du prix total du panier. #}
            <section
                class="cart-card cart-recap-card"
                data-cart-recap
                data-cart-menu-total="{{ prixMenu }}"
                data-cart-reduction="{{ reduction }}"
            >
                <h2>R&eacute;capitulatif</h2>
                <div class="cart-card__line"></div>

                {# Les attributs data-* servent de points d’ancrage aux recalculs réalisés par cart.js. #}
                {% for item in cartItems %}
                    <div class="cart-recap-line" data-cart-line="{{ item.menu.menu_id }}">
                        <span>
                            <strong class="cart-recap-menu-name">{{ item.menu.nom_menu }}</strong>
                            <small
                                data-cart-quantity-label
                                data-menu-name="{{ item.menu.nom_menu }}"
                            >
                                {{ item.nombrePersonnes }} personnes &times; {{ item.menu.prix_par_personne|number_format(2, ',', ' ') }} &euro; / pers.
                            </small>
                        </span>
                        <strong data-cart-line-total>{{ item.prixLigne|number_format(2, ',', ' ') }} &euro;</strong>
                    </div>

                    {# La ligne reste dans le DOM pour pouvoir être affichée si une modification déclenche la réduction. #}
                    <div class="cart-recap-line cart-recap-line--discount" data-cart-discount-line="{{ item.menu.menu_id }}" {% if item.reductionLigne <= 0 %}hidden{% endif %}>
                        <span>R&eacute;duction 10 % {{ item.menu.nom_menu }}</span>
                        <strong data-cart-line-discount>-{{ item.reductionLigne|number_format(2, ',', ' ') }} &euro;</strong>
                    </div>
                {% endfor %}

                {# Total de toutes les réductions du panier. #}
                <div class="cart-recap-line">
                    <span>Total r&eacute;ductions</span>
                    <strong data-cart-total-discount>-{{ reduction|number_format(2, ',', ' ') }} &euro;</strong>
                </div>

                {# Frais de livraison, affichés comme offerts si leur montant est à zéro. #}
                <div class="cart-recap-line">
                    <span>Livraison</span>
                    <strong data-cart-delivery>{{ prixLivraison == 0 ? 'Offerte' : prixLivraison|number_format(2, ',', ' ') ~ ' €' }}</strong>
                </div>

                <div class="cart-card__line"></div>

                {# Total final TTC à payer par le client. #}
                <div class="cart-recap-line cart-recap-line--total">
                    <span>Total TTC</span>
                    <strong data-cart-total>{{ prixTotal|number_format(2, ',', ' ') }} &euro;</strong>
                </div>
            </section>
        </aside>

        {# L’option n’est proposée que si au moins un menu du panier autorise le prêt de matériel. #}
        {% if canRequestMaterial|default(false) %}
            <section class="cart-card cart-material-card">
                <h2>Mat&eacute;riel</h2>
                <div class="cart-card__line"></div>
                <label class="cart-material-choice" for="pret-materiel">
                    <input id="pret-materiel" type="checkbox" name="pret_materiel" value="1">
                    <span>Demande de mat&eacute;riel</span>
                </label>
                <p>Cette demande sera enregistr&eacute;e dans votre commande et permettra &agrave; l'&eacute;quipe de pr&eacute;voir le mat&eacute;riel n&eacute;cessaire.</p>
            </section>
        {% endif %}

        {# Zone de validation finale du panier. #}
        <section class="cart-validation">
            {# formaction distingue la validation définitive de la simple mise à jour des quantités. #}
            <button
                type="submit"
                class="buttonprimary"
                formaction="{{ path('cart_checkout') }}"
                data-cart-checkout-button
                {{ not isConnected ? 'disabled' }}
            >
                Commander
            </button>
            {# Message affiché par JavaScript après une mise à jour réussie du panier. #}
            <p class="cart-update-message" data-cart-update-message hidden>Panier mis &agrave; jour.</p>
            <p>Apr&egrave;s validation, vous recevrez un email de confirmation.</p>
        </section>
    </form>

    {# Chaque suppression utilise une route et un formulaire dédiés au menu concerné. #}
    {% for item in cartItems %}
        <form id="cart-remove-{{ item.menu.menu_id }}" method="post" action="{{ path('cart_remove', { id: item.menu.menu_id }) }}">
            {# Le jeton CSRF protège également les suppressions déclenchées hors du formulaire principal. #}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('cart_action') }}">
        </form>
    {% endfor %}
</main>
{% endblock %}

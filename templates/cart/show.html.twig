{% extends 'base.html.twig' %}

{% block title %}Panier - Vite & Gourmand{% endblock %}

{% block body %}
{% include 'components/_big_title.html.twig' with {
    title: 'Panier',
    image: asset('assets/bigtittle.png'),
    image_alt: 'Table gourmande Vite et Gourmand'
} %}

<main class="cart-page">
    <a href="{{ path('menu_index') }}" class="cart-back-link">Retour aux menus</a>

    {% if not isConnected %}
        <section class="cart-login-notice">
            <p>Vous devez vous connecter ou créer un compte pour valider votre panier.</p>
            <div>
                <a href="{{ path('login', { target: app.request.pathInfo }) }}" class="buttonprimary">Connexion</a>
                <a href="{{ path('register', { target: app.request.pathInfo }) }}" class="buttonwhite">Inscription</a>
            </div>
        </section>
    {% endif %}

    <form class="cart-layout" method="post">
        <div class="cart-left-column">
            <section class="cart-card">
                <h2>Vos informations</h2>
                <div class="cart-card__line"></div>

                <div class="cart-fields cart-fields--two">
                    <label class="cart-field">
                        <span>Nom *</span>
                        <input type="text" name="nom" placeholder="Votre nom" value="{{ customer.nom|default('') }}" {{ not isConnected ? 'disabled' }}>
                    </label>

                    <label class="cart-field">
                        <span>Prénom *</span>
                        <input type="text" name="prenom" placeholder="Votre prénom" value="{{ customer.prenom|default('') }}" {{ not isConnected ? 'disabled' }}>
                    </label>
                </div>

                <div class="cart-fields">
                    <label class="cart-field">
                        <span>Email *</span>
                        <input type="email" name="email" placeholder="votre.mail@exemple.fr" value="{{ customer.email|default('') }}" {{ not isConnected ? 'disabled' }}>
                    </label>

                    <label class="cart-field">
                        <span>Numéro de téléphone *</span>
                        <input type="tel" name="telephone" placeholder="Votre numéro" value="{{ customer.telephone|default('') }}" {{ not isConnected ? 'disabled' }}>
                    </label>
                </div>
            </section>

            <section class="cart-card">
                <h2>Adresse de livraison</h2>
                <div class="cart-card__line"></div>

                <div class="cart-fields">
                    <label class="cart-field">
                        <span>Adresse postale *</span>
                        <input type="text" name="adresse_livraison" placeholder="Votre adresse" value="{{ customer.adresse_postale|default('') }}" {{ not isConnected ? 'disabled' }}>
                    </label>
                </div>

                <div class="cart-fields cart-fields--two">
                    <label class="cart-field">
                        <span>Code postal *</span>
                        <input type="text" name="code_postal_livraison" placeholder="Code postal" value="{{ customer.code_postal|default('') }}" {{ not isConnected ? 'disabled' }}>
                    </label>

                    <label class="cart-field">
                        <span>Ville *</span>
                        <input type="text" name="ville_livraison" placeholder="Ville" value="{{ customer.ville|default('') }}" {{ not isConnected ? 'disabled' }}>
                    </label>
                </div>

                <div class="cart-fields cart-fields--two">
                    <label class="cart-field">
                        <span>Date de livraison</span>
                        <input type="date" name="date_prestation" {{ not isConnected ? 'disabled' }}>
                    </label>

                    <label class="cart-field">
                        <span>Heure souhaitée</span>
                        <input type="time" name="heure_livraison" {{ not isConnected ? 'disabled' }}>
                    </label>
                </div>

                <div class="cart-delivery-info">
                    <span>i</span>
                    <p>
                        La livraison est offerte sur Bordeaux.<br>
                        En dehors de Bordeaux : 5,00 € + 0,59 € par kilomètre.
                    </p>
                </div>
            </section>
        </div>

        <aside class="cart-right-column">
            <section class="cart-card cart-order-card">
                <h2>Votre commande</h2>
                <div class="cart-card__line"></div>

                <div class="cart-order-list">
                    {% for item in cartItems %}
                        {% set menu = item.menu %}
                        <article class="cart-order-card__content">
                            {% if menu.image_url %}
                                <img src="{{ asset(menu.image_url) }}" alt="{{ menu.image_alt ?: menu.nom_menu }}">
                            {% endif %}

                            <div class="cart-order-card__details">
                                <h3>{{ menu.nom_menu }}</h3>
                                <p>{{ item.nombrePersonnes }} personnes minimum</p>
                                <small>{{ menu.prix_par_personne|number_format(2, ',', ' ') }} € / pers</small>
                            </div>

                            <button
                                type="submit"
                                form="cart-remove-{{ menu.menu_id }}"
                                class="cart-remove-button"
                            >
                                Supprimer
                            </button>
                        </article>
                    {% endfor %}
                </div>
            </section>

            <section class="cart-card cart-recap-card">
                <h2>Récapitulatif</h2>
                <div class="cart-card__line"></div>

                {% for item in cartItems %}
                    <div class="cart-recap-line">
                        <span>{{ item.menu.nom_menu }} - {{ item.nombrePersonnes }} personnes</span>
                        <strong>{{ item.prixLigne|number_format(2, ',', ' ') }} €</strong>
                    </div>
                {% endfor %}

                <div class="cart-recap-line">
                    <span>Réduction</span>
                    <strong>-{{ reduction|number_format(2, ',', ' ') }} €</strong>
                </div>

                <div class="cart-recap-line">
                    <span>Livraison</span>
                    <strong>{{ prixLivraison == 0 ? 'Offerte' : prixLivraison|number_format(2, ',', ' ') ~ ' €' }}</strong>
                </div>

                <div class="cart-card__line"></div>

                <div class="cart-recap-line cart-recap-line--total">
                    <span>Total TTC</span>
                    <strong>{{ prixTotal|number_format(2, ',', ' ') }} €</strong>
                </div>
            </section>
        </aside>

        <section class="cart-validation">
            <button type="submit" class="buttonprimary" {{ not isConnected ? 'disabled' }}>Commander</button>
            <p>Après validation, vous recevrez un email de confirmation.</p>
        </section>
    </form>

    {% for item in cartItems %}
        <form id="cart-remove-{{ item.menu.menu_id }}" method="post" action="{{ path('cart_remove', { id: item.menu.menu_id }) }}"></form>
    {% endfor %}
</main>
{% endblock %}

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Si le fichier ou le dossier existe vraiment, Apache le sert directement.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Sinon, la demande est transmise à Symfony.
    RewriteRule ^ index.php [L]
</IfModule>
